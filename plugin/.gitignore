
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# The agent instructions live here and AGENTS.md is a symlink to them, so
# this one overrides the global ignore of CLAUDE.md.
!CLAUDE.md

# The runner's single-instance lock, which is state and not source
testbed/.lock

# Somebody else's server.cfg, replayed with -replay. Named by shape rather than
# by one player's file: a player's cfg was swept in by `git add -A testbed/`
# once and his rcon_password went to a public repository. mvm-2xs.
testbed/replays/*
!testbed/replays/README.md
testbed/*server*.cfg
