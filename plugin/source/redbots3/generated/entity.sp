/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define STATS_CREDITS_DROPPED (0)
#define STATS_CREDITS_ACQUIRED (1)
#define STATS_CREDITS_BONUS (2)
#define STATS_PLAYER_DEATHS (3)
#define STATS_BUYBACKS (4)

stock float[] GetAbsAngles(int entity)
{
	float vec[3];
	CBaseEntity(entity).GetAbsAngles(vec);
	return vec;
}

stock void RemoveEffects(int ent, int effects)
{
	SetEntProp(ent, Prop_Send, "m_fEffects", GetEntProp(ent, Prop_Send, "m_fEffects") & ~effects);
	if ((effects & EF_NODRAW) != 0)
	{
		CBaseEntity(ent).DispatchUpdateTransmitState();
	}
}

stock bool HasBackstabPotential(int client)
{
	if (TF2_GetClientTeam(client) == TFTeam_Blue)
	{
		if (TF2_IsPlayerInCondition(client, TFCond_MVMBotRadiowave))
		{
			return true;
		}
		if (TF2_IsPlayerInCondition(client, TFCond_Sapped) && !TF2_IsMiniBoss(client))
		{
			return true;
		}
	}
	return false;
}

stock int GetControlPointByID(int pointID)
{
	int ent = -1;
	for (;;)
	{
		ent = FindEntityByClassname(ent, "team_control_point");
		if (ent == -1)
		{
			break;
		}
		if (GetEntProp(ent, Prop_Data, "m_iPointIndex") == pointID)
		{
			return ent;
		}
	}
	return -1;
}

stock int GetNearestReviveMarker(int client, const float maxDistance)
{
	float origin[3];
	GetClientAbsOrigin(client, origin);
	float bestDistance = 999999.0;
	int bestEntity = -1;
	int ent = -1;
	for (;;)
	{
		ent = FindEntityByClassname(ent, "entity_revive_marker");
		if (ent == -1)
		{
			break;
		}
		if (BaseEntity_GetTeamNumber(ent) != GetClientTeam(client))
		{
			continue;
		}
		float distance = GetVectorDistance(origin, GetAbsOrigin(ent));
		if ((distance <= bestDistance) && (distance <= maxDistance))
		{
			bestDistance = distance;
			bestEntity = ent;
		}
	}
	return bestEntity;
}

stock float[] GetBombHatchPosition(bool useAbsOrigin = false)
{
	float origin[3];
	int hole = FindEntityByClassname(-1, "func_capturezone");
	if (hole != -1)
	{
		if (useAbsOrigin)
		{
			origin = GetAbsOrigin(hole);
		}
		else
		{
			origin = WorldSpaceCenter(hole);
		}
	}
	return origin;
}

stock int GetAcquiredCreditsOfAllWaves(bool withBonus = true)
{
	int ent = FindEntityByClassname(MaxClients + 1, "tf_mann_vs_machine_stats");
	if (ent == -1)
	{
		LogError("GetAcquiredCreditsOfAllWaves: Could not find entity tf_mann_vs_machine_stats!");
		return 0;
	}
	int total = GetEntProp(ent, Prop_Send, "m_runningTotalWaveStats", STATS_CREDITS_ACQUIRED, _);
	total += GetEntProp(ent, Prop_Send, "m_previousWaveStats", STATS_CREDITS_ACQUIRED, _);
	total += GetEntProp(ent, Prop_Send, "m_currentWaveStats", STATS_CREDITS_ACQUIRED, _);
	if (withBonus)
	{
		total += GetEntProp(ent, Prop_Send, "m_runningTotalWaveStats", STATS_CREDITS_BONUS, _);
		total += GetEntProp(ent, Prop_Send, "m_previousWaveStats", STATS_CREDITS_BONUS, _);
		total += GetEntProp(ent, Prop_Send, "m_currentWaveStats", STATS_CREDITS_BONUS, _);
	}
	return total;
}

