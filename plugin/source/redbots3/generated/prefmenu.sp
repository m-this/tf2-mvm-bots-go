/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define Go_prefScout (1)
#define Go_prefSoldier (2)
#define Go_prefPyro (4)
#define Go_prefDemo (8)
#define Go_prefHeavy (16)
#define Go_prefEngineer (32)
#define Go_prefMedic (64)
#define Go_prefSniper (128)
#define Go_prefSpy (256)

char m_sSelectedClass[65][16];
Menu g_hBotPreferenceMenu;
Menu m_hWeaponPrefClassMenu;

stock void DisplayClassPreferenceMenu(int client, int item = 0)
{
	int flags = GetClassPreferencesFlags(client);
	Menu hClassPrefMenu = CreateMenu(MenuHandler_ClassPreference);
	SetMenuTitle(hClassPrefMenu, "Bot Class Preferences");
	SetMenuExitBackButton(hClassPrefMenu, true);
	AddMenuItem(hClassPrefMenu, "0", ((flags & Go_prefScout) != 0 ? "Scout: Yes" : "Scout: No"));
	AddMenuItem(hClassPrefMenu, "1", ((flags & Go_prefSoldier) != 0 ? "Soldier: Yes" : "Soldier: No"));
	AddMenuItem(hClassPrefMenu, "2", ((flags & Go_prefPyro) != 0 ? "Pyro: Yes" : "Pyro: No"));
	AddMenuItem(hClassPrefMenu, "3", ((flags & Go_prefDemo) != 0 ? "Demoman: Yes" : "Demoman: No"));
	AddMenuItem(hClassPrefMenu, "4", ((flags & Go_prefHeavy) != 0 ? "Heavy: Yes" : "Heavy: No"));
	AddMenuItem(hClassPrefMenu, "5", ((flags & Go_prefEngineer) != 0 ? "Engineer: Yes" : "Engineer: No"));
	AddMenuItem(hClassPrefMenu, "6", ((flags & Go_prefMedic) != 0 ? "Medic: Yes" : "Medic: No"));
	AddMenuItem(hClassPrefMenu, "7", ((flags & Go_prefSniper) != 0 ? "Sniper: Yes" : "Sniper: No"));
	AddMenuItem(hClassPrefMenu, "8", ((flags & Go_prefSpy) != 0 ? "Spy: Yes" : "Spy: No"));
	DisplayMenuAtItem(hClassPrefMenu, client, item, MENU_TIME_FOREVER);
}

stock int MenuHandler_ClassPreference(Menu menu, MenuAction action, int param1, int param2)
{
	switch (action)
	{
		case MenuAction_Select:
		{
			int flags = GetClassPreferencesFlags(param1);
			switch (param2)
			{
				case 0:
				{
					SetClassPreferences(param1, "scout", ((flags & Go_prefScout) != 0 ? 0 : 1));
				}
				case 1:
				{
					SetClassPreferences(param1, "soldier", ((flags & Go_prefSoldier) != 0 ? 0 : 1));
				}
				case 2:
				{
					SetClassPreferences(param1, "pyro", ((flags & Go_prefPyro) != 0 ? 0 : 1));
				}
				case 3:
				{
					SetClassPreferences(param1, "demoman", ((flags & Go_prefDemo) != 0 ? 0 : 1));
				}
				case 4:
				{
					SetClassPreferences(param1, "heavyweapons", ((flags & Go_prefHeavy) != 0 ? 0 : 1));
				}
				case 5:
				{
					SetClassPreferences(param1, "engineer", ((flags & Go_prefEngineer) != 0 ? 0 : 1));
				}
				case 6:
				{
					SetClassPreferences(param1, "medic", ((flags & Go_prefMedic) != 0 ? 0 : 1));
				}
				case 7:
				{
					SetClassPreferences(param1, "sniper", ((flags & Go_prefSniper) != 0 ? 0 : 1));
				}
				case 8:
				{
					SetClassPreferences(param1, "spy", ((flags & Go_prefSpy) != 0 ? 0 : 1));
				}
			}
			DisplayClassPreferenceMenu(param1, GetMenuSelectionPosition());
		}
		case MenuAction_End:
		{
			menu.Close();
		}
		case MenuAction_Cancel:
		{
			if (param2 == MenuCancel_ExitBack)
			{
				DisplayMenu(g_hBotPreferenceMenu, param1, MENU_TIME_FOREVER);
			}
		}
	}
	return 0;
}

stock int MenuHandler_BotVote(Menu menu, MenuAction action, int param1, int param2)
{
	switch (action)
	{
		case MenuAction_VoteEnd:
		{
			if (param1 == 0)
			{
				ManageDefenderBots(true);
			}
			else
				if (param1 == 1)
				{
					g_iUIDBotSummoner = 0;
					PrintToChatAll("%s Bot vote was unsuccessful!", PLUGIN_PREFIX);
				}
		}
		case MenuAction_VoteCancel:
		{
			g_iUIDBotSummoner = 0;
		}
	}
	return 0;
}

stock void DefenderBotTeamSetupCancelled()
{
	switch (redbots_manager_bot_lineup_mode.IntValue)
	{
		case BOT_LINEUP_MODE_PREFERENCE_CHOOSE:
		{
			UpdateChosenBotTeamComposition();
		}
		case BOT_LINEUP_MODE_CHOOSE:
		{
			g_adtChosenBotClasses.Clear();
		}
	}
}

stock int MenuHandler_BotPreferenceMain(Menu menu, MenuAction action, int param1, int param2)
{
	switch (action)
	{
		case MenuAction_Select:
		{
			switch (param2)
			{
				case 0:
				{
					DisplayClassPreferenceMenu(param1, 0);
				}
				case 1:
				{
					if (!redbots_manager_use_custom_loadouts.BoolValue)
					{
						PrintToChat(param1, "%s Custom loadouts are not enabled.", PLUGIN_PREFIX);
						return 0;
					}
					DisplayMenu(m_hWeaponPrefClassMenu, param1, MENU_TIME_FOREVER);
				}
			}
		}
	}
	return 0;
}

