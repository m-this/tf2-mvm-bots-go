/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define ADDRESS_CELL_MASK (4294967295)

// Widen is the Address of a pointer held in a cell, zero-extended.
stock Address AddressOfCell(int cell)
{
	return view_as<Address>(cell) & ADDRESS_CELL_MASK;
}

// Narrow is the cell a pointer fits in. It throws when the high half is
// anything but the extension of the low one: zero, or all ones above a low
// half whose top bit is set.
stock int CellOfAddress(Address address)
{
	Address high = address >> 32;
	int low = view_as<int>(address);
	if ((high != 0) && ((high != -1) || (low >= 0)))
	{
		ThrowError("Address %08x%08x does not fit a cell", view_as<int>(high), low);
	}
	return low;
}

