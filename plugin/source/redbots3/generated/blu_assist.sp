/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define BLU_ASSIST_EPSILON (0.0001)

#define BLU_ASSIST_SETTLE (0.1)

#define BLU_ASSIST_SAMPLE (25)

int m_iBluAssistSeen;
int m_iBluAssistMaxHealth[65];
int m_iBluAssistWasHealth[65];
ConVar redbots_manager_blu_health_scale;
ConVar redbots_manager_blu_health_debug;

stock void BluAssist_Init()
{
	m_iBluAssistSeen = 0;
	redbots_manager_blu_health_scale = CreateConVar("sm_redbots_manager_blu_health_scale", "1.0", "What every BLU robot's maximum health is multiplied by. 1.0 is off.", FCVAR_NOTIFY, true, 0.1, true, 10.0);
	redbots_manager_blu_health_debug = CreateConVar("sm_redbots_manager_blu_health_debug", "0", "Log the original, wanted and observed health of every robot the lever bends, rather than one in BLU_ASSIST_SAMPLE.", FCVAR_NONE, true, 0.0, true, 1.0);
}

stock float BluAssist_HealthScale()
{
	return redbots_manager_blu_health_scale.FloatValue;
}

stock bool BluAssistOff(float scale)
{
	return FloatAbs(scale - 1.0) < BLU_ASSIST_EPSILON;
}

stock Action BluAssistGetMaxHealth(int entity, int &maxHealth)
{
	if (m_iBluAssistMaxHealth[entity] <= 0)
	{
		return Plugin_Continue;
	}
	maxHealth = m_iBluAssistMaxHealth[entity];
	return Plugin_Changed;
}

stock void BluAssist_Describe(char[] buffer, int maxlength)
{
	if ((redbots_manager_blu_health_scale == null) || BluAssistOff(redbots_manager_blu_health_scale.FloatValue))
	{
		return;
	}
	Format(buffer, maxlength, "blu_health=%.2f", redbots_manager_blu_health_scale.FloatValue);
}

stock void BluAssist_OnRobotSpawn(int client)
{
	SDKUnhook(client, SDKHook_GetMaxHealth, BluAssistGetMaxHealth);
	m_iBluAssistMaxHealth[client] = 0;
	m_iBluAssistWasHealth[client] = 0;
	if (BluAssistOff(BluAssist_HealthScale()))
	{
		return;
	}
	CreateTimer(BLU_ASSIST_SETTLE, BluAssistApplyToRobot, GetClientUserId(client), TIMER_FLAG_NO_MAPCHANGE);
}

stock Action BluAssistApplyToRobot(Handle timer, int userid)
{
	int client = GetClientOfUserId(userid);
	if ((client <= 0) || !IsClientInGame(client) || !IsPlayerAlive(client))
	{
		return Plugin_Stop;
	}
	if ((TF2_GetClientTeam(client) != TFTeam_Blue) || !IsFakeClient(client))
	{
		return Plugin_Stop;
	}
	float scale = BluAssist_HealthScale();
	if (BluAssistOff(scale))
	{
		return Plugin_Stop;
	}
	int maxHealth = TEMP_GetPlayerMaxHealth(client);
	if (maxHealth < GetClientHealth(client))
	{
		maxHealth = GetClientHealth(client);
	}
	int wanted = RoundToCeil(float(maxHealth) * scale);
	if (wanted < 1)
	{
		wanted = 1;
	}
	m_iBluAssistWasHealth[client] = maxHealth;
	m_iBluAssistMaxHealth[client] = wanted;
	SDKHook(client, SDKHook_GetMaxHealth, BluAssistGetMaxHealth);
	SetEntProp(client, Prop_Data, "m_iMaxHealth", wanted);
	SetEntityHealth(client, wanted);
	CreateTimer(BLU_ASSIST_SETTLE, BluAssistVerifyRobot, userid, TIMER_FLAG_NO_MAPCHANGE);
	return Plugin_Stop;
}

stock Action BluAssistVerifyRobot(Handle timer, int userid)
{
	int client = GetClientOfUserId(userid);
	if ((client <= 0) || !IsClientInGame(client) || !IsPlayerAlive(client))
	{
		return Plugin_Stop;
	}
	if ((TF2_GetClientTeam(client) != TFTeam_Blue) || !IsFakeClient(client))
	{
		return Plugin_Stop;
	}
	BluAssistSay(client, TEMP_GetPlayerMaxHealth(client));
	return Plugin_Stop;
}

stock void BluAssistSay(int client, int observed)
{
	int wanted = m_iBluAssistMaxHealth[client];
	if (wanted <= 0)
	{
		return;
	}
	m_iBluAssistSeen++;
	bool mismatch = (observed != wanted) || (GetClientHealth(client) != wanted);
	if (!mismatch && !redbots_manager_blu_health_debug.BoolValue && ((m_iBluAssistSeen % BLU_ASSIST_SAMPLE) != 0))
	{
		return;
	}
	if (mismatch)
	{
		LogMessage("BluAssist: robot %d of the wave, was %d, wanted %d (x%.2f), game says %d and health %d: MISMATCH", m_iBluAssistSeen, m_iBluAssistWasHealth[client], wanted, BluAssist_HealthScale(), observed, GetClientHealth(client));
		return;
	}
	LogMessage("BluAssist: robot %d of the wave, was %d, wanted %d (x%.2f), game says %d and health %d", m_iBluAssistSeen, m_iBluAssistWasHealth[client], wanted, BluAssist_HealthScale(), observed, GetClientHealth(client));
}

