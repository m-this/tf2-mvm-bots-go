/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define BLU_ASSIST_FULL_TEAM (6.0)

#define BLU_ASSIST_SAMPLE (25)

int m_iBluAssistSeen;
ConVar redbots_manager_blu_health_scale;

stock void BluAssist_Init()
{
	m_iBluAssistSeen = 0;
	redbots_manager_blu_health_scale = CreateConVar("sm_redbots_manager_blu_health_scale", "1.0", "What a robot's health is multiplied by when one human is on RED. Rises to 1.0 at six. 1.0 is off.", FCVAR_NOTIFY, true, 0.1, true, 1.0);
}

stock int BluAssist_HumansOnRed()
{
	int count = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && !IsFakeClient(i) && !IsClientSourceTV(i) && (TF2_GetClientTeam(i) == TFTeam_Red))
		{
			count++;
		}
	}
	return count;
}

stock float BluAssistScale(ConVar convar)
{
	float atOne = convar.FloatValue;
	if (atOne >= 1.0)
	{
		return 1.0;
	}
	float humans = float(BluAssist_HumansOnRed());
	if (humans < 1.0)
	{
		humans = 1.0;
	}
	if (humans >= BLU_ASSIST_FULL_TEAM)
	{
		return 1.0;
	}
	return atOne + ((1.0 - atOne) * ((humans - 1.0) / 5.0));
}

stock float BluAssist_HealthScale()
{
	return BluAssistScale(redbots_manager_blu_health_scale);
}

stock void BluAssist_Describe(char[] buffer, int maxlength)
{
	if ((redbots_manager_blu_health_scale == null) || (redbots_manager_blu_health_scale.FloatValue >= 1.0))
	{
		return;
	}
	Format(buffer, maxlength, "blu_health=%.2f", redbots_manager_blu_health_scale.FloatValue);
}

stock void BluAssist_OnRobotSpawn(int client)
{
	if (BluAssist_HealthScale() >= 1.0)
	{
		return;
	}
	RequestFrame(BluAssistApplyToRobot, GetClientUserId(client));
}

public void BluAssistApplyToRobot(int userid)
{
	int client = GetClientOfUserId(userid);
	if ((client <= 0) || !IsClientInGame(client) || !IsPlayerAlive(client))
	{
		return;
	}
	if ((TF2_GetClientTeam(client) != TFTeam_Blue) || !IsFakeClient(client))
	{
		return;
	}
	float health = BluAssist_HealthScale();
	if (health < 1.0)
	{
		int maxHealth = GetEntProp(client, Prop_Data, "m_iMaxHealth");
		int wanted = RoundToCeil(float(maxHealth) * health);
		if (wanted < 1)
		{
			wanted = 1;
		}
		BluAssistBendAttrib(client, "max health additive bonus", 0.0, float(wanted - maxHealth), 1.0);
		SetEntProp(client, Prop_Data, "m_iMaxHealth", wanted);
		SetEntityHealth(client, wanted);
	}
	BluAssistSay(client, health);
}

stock void BluAssistSay(int client, float health)
{
	if (health >= 1.0)
	{
		return;
	}
	m_iBluAssistSeen++;
	if ((m_iBluAssistSeen % BLU_ASSIST_SAMPLE) != 0)
	{
		return;
	}
	LogMessage("BluAssist: robot %d of the wave, health %d of %d, wanted x%.2f", m_iBluAssistSeen, GetClientHealth(client), GetEntProp(client, Prop_Data, "m_iMaxHealth"), health);
}

stock void BluAssistBendAttrib(int client, const char[] name, float neutral, float delta, float scale = 1.0)
{
	int attrib = TF2Attrib_GetByName(client, name);
	float current = neutral;
	if (attrib != Address_Null)
	{
		current = TF2Attrib_GetValue(attrib);
	}
	TF2Attrib_SetByName(client, name, (current * scale) + delta);
}

