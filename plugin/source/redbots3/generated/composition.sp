/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define Go_Classes (10)

#define Go_Seats (65)

stock void GetWantedTeamComposition(char[] out, int maxlen)
{
	redbots_manager_team_composition.GetString(out, maxlen);
	if (out[0] != 0)
	{
		return;
	}
	strcopy(out, maxlen, g_arrMapConfig.strComposition);
}

stock bool IsClassInTeamComposition(const char[] class, bool bTypedTeamOnly = false)
{
	char list[512];
	if (bTypedTeamOnly)
	{
		redbots_manager_team_composition.GetString(list, 512);
	}
	else
	{
		GetWantedTeamComposition(list, 512);
	}
	if (list[0] == 0)
	{
		return false;
	}
	TFClassType wanted = TF2_GetClassIndexFromString(class);
	if (wanted == TFClass_Unknown)
	{
		return false;
	}
	char entries[65][512];
	int count = ExplodeString(list, ",", entries, Go_Seats, 512);
	for (int i = 0; i < count; i++)
	{
		TrimString(entries[i]);
		if (TF2_GetClassIndexFromString(entries[i]) == wanted)
		{
			return true;
		}
	}
	return false;
}

stock bool IsBotClassBlacklisted(const char[] class)
{
	if (IsClassInTeamComposition(class, true))
	{
		return false;
	}
	char list[512];
	redbots_manager_class_blacklist.GetString(list, 512);
	if (list[0] == 0)
	{
		return false;
	}
	TFClassType wanted = TF2_GetClassIndexFromString(class);
	if (wanted == TFClass_Unknown)
	{
		return false;
	}
	char entries[9][512];
	int count = ExplodeString(list, ",", entries, 9, 512);
	for (int i = 0; i < count; i++)
	{
		TrimString(entries[i]);
		if (TF2_GetClassIndexFromString(entries[i]) == wanted)
		{
			return true;
		}
	}
	return false;
}

stock void PickAllowedBotClass(const char[] wanted, char[] buffer, int maxlen)
{
	strcopy(buffer, maxlen, wanted);
	if (!IsBotClassBlacklisted(wanted))
	{
		return;
	}
	char candidates[9][512];
	int total = 0;
	for (TFClassType i = TFClass_Scout; i <= TFClass_Engineer; i++)
	{
		if (!IsBotClassBlacklisted(g_sRawPlayerClassNames[i]))
		{
			strcopy(candidates[total], TF2_CLASS_MAX_NAME_LENGTH, g_sRawPlayerClassNames[i]);
			total++;
		}
	}
	if (total == 0)
	{
		return;
	}
	strcopy(buffer, maxlen, candidates[GetRandomInt(0, total - 1)]);
}

stock int CollectMissingTeamComposition(ArrayList classes, ArrayList seats, int count)
{
	char list[512];
	GetWantedTeamComposition(list, 512);
	if (list[0] == 0)
	{
		return 0;
	}
	char wanted[65][512];
	int total = ExplodeString(list, ",", wanted, Go_Seats, 512);
	int held[10];
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && IsDefenderBot(i) && (TF2_GetClientTeam(i) == TFTeam_Red))
		{
			held[TF2_GetPlayerClass(i)]++;
		}
	}
	int collected = 0;
	for (int i = 0; (i < total) && (collected < count); i++)
	{
		TrimString(wanted[i]);
		TFClassType class = TF2_GetClassIndexFromString(wanted[i]);
		if (class == TFClass_Unknown)
		{
			continue;
		}
		if (held[class] > 0)
		{
			held[class]--;
			continue;
		}
		classes.PushString(wanted[i]);
		seats.Push(i + 1);
		collected++;
	}
	return collected;
}

stock int AddBotsFromTeamComposition(int count)
{
	ArrayList classes = new ArrayList(TF2_CLASS_MAX_NAME_LENGTH);
	ArrayList seats = new ArrayList();
	int added = CollectMissingTeamComposition(classes, seats, count);
	for (int i = 0; i < classes.Length; i++)
	{
		char class[512];
		classes.GetString(i, class, 512);
		NoteBotSeatPending(seats.Get(i));
		AddDefenderTFBot(1, class, "red", "expert");
	}
	classes.Close();
	seats.Close();
	if (added > 0)
	{
		PrintToChatAll("%s Adding %d bot(s)...", PLUGIN_PREFIX, added);
	}
	LogMessage("Fill: the named team filled %d of %d", added, count);
	return added;
}

stock int ReseatDefenderBots()
{
	char list[512];
	GetWantedTeamComposition(list, 512);
	if (list[0] == 0)
	{
		return 0;
	}
	char wanted[65][512];
	int total = ExplodeString(list, ",", wanted, Go_Seats, 512);
	int spare[10];
	ArrayList bots = new ArrayList();
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && IsDefenderBot(i) && (TF2_GetClientTeam(i) == TFTeam_Red))
		{
			spare[TF2_GetPlayerClass(i)]++;
			bots.Push(i);
		}
	}
	int missing = 0;
	for (int i = 0; i < total; i++)
	{
		TrimString(wanted[i]);
		TFClassType class = TF2_GetClassIndexFromString(wanted[i]);
		if (class == TFClass_Unknown)
		{
			continue;
		}
		if (spare[class] > 0)
		{
			spare[class]--;
		}
		else
		{
			missing++;
		}
	}
	int kicked = 0;
	for (int i = 0; (i < bots.Length) && (kicked < missing); i++)
	{
		int client = bots.Get(i);
		if (!IsClientInGame(client))
		{
			continue;
		}
		TFClassType class = TF2_GetPlayerClass(client);
		if (spare[class] < 1)
		{
			continue;
		}
		spare[class]--;
		kicked++;
		ClearBuildingsBeforeKick(client);
		KickClient(client, "BotManager3: the lineup changed");
	}
	bots.Close();
	if (kicked > 0)
	{
		LogMessage("Reseat: the lineup wants %d seat(s) nobody holds, kicked %d bot(s) for them", missing, kicked);
		PrintToChatAll("%s Changing %d bot(s) to match the new lineup...", PLUGIN_PREFIX, kicked);
	}
	return kicked;
}

