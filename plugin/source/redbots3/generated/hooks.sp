/* Generated by internal/spbody from the Go it is named after. Do not edit. */

// MainActionUpdate is the top of every bot's stack, and the only thing the mod
// wants from it is the fault injector's hook.
//
// Emptying a stack on purpose is how the idle watchdog gets tested: a bot with no
// behaviour is exactly the one nothing else notices.
public Action CTFBotMainAction_Update(BehaviorAction action, int actor, float interval, ActionResult result)
{
	if (g_bIsDefenderBot[actor] && DebugFaults_ShouldEmpty(actor))
	{
		return action.Done("DebugFaults: emptying the stack");
	}
	return Plugin_Continue;
}

// FetchFlagOnStart refuses: a defender has no bomb to fetch.
public Action CTFBotFetchFlag_OnStart(BehaviorAction action, int actor, BehaviorAction priorAction, ActionResult result)
{
	if (!g_bIsDefenderBot[actor])
	{
		return Plugin_Continue;
	}
	return action.Done();
}

// MvMEngineerIdleOnStart refuses: our engineer has his own idle.
