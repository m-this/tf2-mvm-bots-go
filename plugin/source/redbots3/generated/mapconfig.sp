/* Generated by internal/spbody from the Go it is named after. Do not edit. */

stock void Config_LoadNestSpots(KeyValues kv, const char[] key, ArrayList locations, ArrayList zones)
{
	if (!kv.JumpToKey(key, false))
	{
		return;
	}
	if (kv.GotoFirstSubKey(false))
	{
		for (;;)
		{
			float vec[3];
			kv.GetVector("origin", vec);
			locations.PushArray(vec);
			char zone[512];
			kv.GetString("zone", zone, 512, "");
			zones.PushString(zone);
			if (!kv.GotoNextKey(false))
			{
				break;
			}
		}
		kv.GoBack();
	}
	kv.GoBack();
}

stock void Config_LoadLocations(KeyValues kv, const char[] key, ArrayList locations)
{
	if (!kv.JumpToKey(key, false))
	{
		return;
	}
	if (kv.GotoFirstSubKey(false))
	{
		for (;;)
		{
			float vec[3];
			kv.GetVector("origin", vec);
			locations.PushArray(vec);
			if (!kv.GotoNextKey(false))
			{
				break;
			}
		}
		kv.GoBack();
	}
	kv.GoBack();
}

stock void Config_LoadBotNames()
{
	char filePath[512];
	BuildPath(Path_SM, filePath, 512, "configs/defenderbots/bot_names.txt");
	File hConfigFile = OpenFile(filePath, "r");
	if (hConfigFile == null)
	{
		LogError("Config_LoadBotNames: Could not locate file %s!", filePath);
		return;
	}
	m_adtBotNames.Clear();
	for (;;)
	{
		char currentLine[512];
		bool ok = ReadFileLine(hConfigFile, currentLine, 512);
		if (!ok)
		{
			break;
		}
		TrimString(currentLine);
		if (strlen(currentLine) > 0)
		{
			m_adtBotNames.PushString(currentLine);
		}
	}
	delete hConfigFile;
}

