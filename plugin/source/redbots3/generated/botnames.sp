/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define Go_Slots (65)

#define Go_MaxTries (10)

char g_sPlayerUseMyNameResponse[][] =
{
	"You're very funny for using my name.",
	"You totally stole my name.",
};
int m_iFindNameTries[65];

stock void SetRandomNameOnBot(int client)
{
	char newName[512];
	GetRandomDefenderBotName(newName, 512);
	if ((m_adtBotNames.Length > 0) && DoesAnyPlayerUseThisName(newName) && (m_iFindNameTries[client] < Go_MaxTries))
	{
		m_iFindNameTries[client]++;
		PrintToChatAll("%s : %s", newName, g_sPlayerUseMyNameResponse[GetRandomInt(0, 1)]);
		SetRandomNameOnBot(client);
		return;
	}
	m_iFindNameTries[client] = 0;
	SetClientName(client, newName);
}

stock void GetRandomDefenderBotName(char[] buffer, int maxlen)
{
	if (m_adtBotNames.Length == 0)
	{
		strcopy(buffer, maxlen, "You forgot to give me a name!");
		return;
	}
	char botName[512];
	m_adtBotNames.GetString(GetRandomInt(0, m_adtBotNames.Length - 1), botName, 512);
	strcopy(buffer, maxlen, botName);
}

