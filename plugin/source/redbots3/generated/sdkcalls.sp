// GetBonePosition is where that bone is and how it is turned.
stock void GetBonePosition(int entity, int iBone, float origin[3], float angles[3])
{
	for (int i = 0; i < 3; i++)
	{
		origin[i] = 0.0;
	}
	for (int i = 0; i < 3; i++)
	{
		angles[i] = 0.0;
	}
	SDKCall(m_hGetBonePosition, entity, iBone, origin, angles);
	return;
}

