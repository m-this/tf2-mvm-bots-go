stock bool IsPipeLauncher(int weaponID)
{
	switch (weaponID)
	{
		case TF_WEAPON_GRENADELAUNCHER, TF_WEAPON_PIPEBOMBLAUNCHER, TF_WEAPON_CANNON:
		{
