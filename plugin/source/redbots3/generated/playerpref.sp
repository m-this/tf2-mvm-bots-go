/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define Go_Slots (65)

#define MAXPLAYERS (64)

#define TF2_CLASS_MAX_NAME_LENGTH (14)

#define PREF_FL_NONE (0)
#define PREF_FL_SCOUT (1)
#define PREF_FL_SOLDIER (2)
#define PREF_FL_PYRO (4)
#define PREF_FL_DEMO (8)
#define PREF_FL_HEAVY (16)
#define PREF_FL_ENGINEER (32)
#define PREF_FL_MEDIC (64)
#define PREF_FL_SNIPER (128)
#define PREF_FL_SPY (256)

#define Go_ItemDefDefault (-1)

int m_iBotSeat[65];
ArrayList m_adtPendingBotSeats;

stock bool IsValidLoadoutSeat(int seat)
{
	return (seat >= 1) && (seat <= MAXPLAYERS);
}

stock void WarnAboutInvalidLoadoutSeats()
{
	m_kvServerLoadout.Rewind();
	if (!m_kvServerLoadout.JumpToKey("seats", false) || !m_kvServerLoadout.GotoFirstSubKey())
	{
		m_kvServerLoadout.Rewind();
		return;
	}
	for (;;)
	{
		char section[512];
		m_kvServerLoadout.GetSectionName(section, 512);
		if (!IsValidLoadoutSeat(StringToInt(section)))
		{
			LogError("Config_LoadServerLoadout: seat \"%s\" is not between 1 and %d, ignoring it", section, MAXPLAYERS);
		}
		if (!m_kvServerLoadout.GotoNextKey())
		{
			break;
		}
	}
	m_kvServerLoadout.Rewind();
}

stock bool JumpToServerLoadoutSeat(int seat, const char[] class)
{
	if (!IsValidLoadoutSeat(seat))
	{
		return false;
	}
	char section[512];
	IntToString(section, 512, seat);
	if (!m_kvServerLoadout.JumpToKey("seats", false) || !m_kvServerLoadout.JumpToKey(section, false))
	{
		m_kvServerLoadout.Rewind();
		return false;
	}
	char seatClass[512];
	m_kvServerLoadout.GetString("class", seatClass, 512);
	if (StrEqual(seatClass, class, false))
	{
		return true;
	}
	m_kvServerLoadout.Rewind();
	return false;
}

stock int GetServerLoadoutWeapon(int seat, const char[] class, const char[] slot)
{
	m_kvServerLoadout.Rewind();
	if (!JumpToServerLoadoutSeat(seat, class) && !m_kvServerLoadout.JumpToKey(class, false))
	{
		return Go_ItemDefDefault;
	}
	int weaponIndex = m_kvServerLoadout.GetNum(slot, Go_ItemDefDefault);
	m_kvServerLoadout.Rewind();
	return weaponIndex;
}

stock void NoteBotSeatPending(int seat)
{
	if (m_adtPendingBotSeats == null)
	{
		m_adtPendingBotSeats = new ArrayList();
	}
	if (m_adtPendingBotSeats.Length >= MAXPLAYERS)
	{
		m_adtPendingBotSeats.Erase(0);
	}
	m_adtPendingBotSeats.Push(seat);
}

stock void TakeBotSeat(int client)
{
	m_iBotSeat[client] = 0;
	if ((m_adtPendingBotSeats == null) || (m_adtPendingBotSeats.Length < 1))
	{
		return;
	}
	m_iBotSeat[client] = m_adtPendingBotSeats.Get(0);
	m_adtPendingBotSeats.Erase(0);
}

stock void ForgetBotSeat(int client)
{
	m_iBotSeat[client] = 0;
}

stock int GetClassPreferencesFlags(int client)
{
	char steamID[512];
	bool found = GetClientAuthId(client, steamID, 512, AuthId_Steam3);
	if (!found)
	{
		LogError("GetClassPreferencesFlags: failed to get Steam ID for %L", client);
		return PREF_FL_NONE;
	}
	int flags = 0;
	m_kvPlayerPrefData.JumpToKey(steamID, true);
	m_kvPlayerPrefData.JumpToKey("class", true);
	if (m_kvPlayerPrefData.GetNum("scout", 0) == 1)
	{
		flags |= PREF_FL_SCOUT;
	}
	if (m_kvPlayerPrefData.GetNum("soldier", 0) == 1)
	{
		flags |= PREF_FL_SOLDIER;
	}
	if (m_kvPlayerPrefData.GetNum("pyro", 0) == 1)
	{
		flags |= PREF_FL_PYRO;
	}
	if (m_kvPlayerPrefData.GetNum("demoman", 0) == 1)
	{
		flags |= PREF_FL_DEMO;
	}
	if (m_kvPlayerPrefData.GetNum("heavyweapons", 0) == 1)
	{
		flags |= PREF_FL_HEAVY;
	}
	if (m_kvPlayerPrefData.GetNum("engineer", 0) == 1)
	{
		flags |= PREF_FL_ENGINEER;
	}
	if (m_kvPlayerPrefData.GetNum("medic", 0) == 1)
	{
		flags |= PREF_FL_MEDIC;
	}
	if (m_kvPlayerPrefData.GetNum("sniper", 0) == 1)
	{
		flags |= PREF_FL_SNIPER;
	}
	if (m_kvPlayerPrefData.GetNum("spy", 0) == 1)
	{
		flags |= PREF_FL_SPY;
	}
	m_kvPlayerPrefData.Rewind();
	return flags;
}

stock void SetClassPreferences(int client, const char[] class, int value)
{
	char steamID[512];
	bool found = GetClientAuthId(client, steamID, 512, AuthId_Steam3);
	if (!found)
	{
		LogError("SetClassPreferences: failed to get Steam ID for %L", client);
		return;
	}
	m_kvPlayerPrefData.JumpToKey(steamID, true);
	m_kvPlayerPrefData.JumpToKey("class", true);
	m_kvPlayerPrefData.SetNum(class, value);
	m_kvPlayerPrefData.Rewind();
}

stock int GetWeaponPreference(int client, const char[] class, const char[] slot)
{
	char steamID[512];
	bool found = GetClientAuthId(client, steamID, 512, AuthId_Steam3);
	if (!found)
	{
		LogError("GetWeaponPreference: failed to get Steam ID for %L", client);
		return Go_ItemDefDefault;
	}
	int weaponIndex;
	m_kvPlayerPrefData.JumpToKey(steamID, true);
	m_kvPlayerPrefData.JumpToKey("loadout", true);
	m_kvPlayerPrefData.JumpToKey(class, true);
	weaponIndex = m_kvPlayerPrefData.GetNum(slot, Go_ItemDefDefault);
	m_kvPlayerPrefData.Rewind();
	return weaponIndex;
}

stock int GetPreferredWeaponForClass(const char[] class, const char[] slot, int client)
{
	if (m_kvServerLoadout != null)
	{
		return GetServerLoadoutWeapon(m_iBotSeat[client], class, slot);
	}
	if (g_iPlayerForcedPref != -1)
	{
		return GetWeaponPreference(g_iPlayerForcedPref, class, slot);
	}
	ArrayList weaponPref = new ArrayList();
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && IsValidForBotPreferences(i))
		{
			int prefWeapon = GetWeaponPreference(i, class, slot);
			if (prefWeapon != Go_ItemDefDefault)
			{
				weaponPref.Push(prefWeapon);
			}
		}
	}
	if (weaponPref.Length < 1)
	{
		weaponPref.Close();
		return GetRandomWeaponForClass(class, slot);
	}
	int itemDefIndex = weaponPref.Get(GetRandomInt(0, weaponPref.Length - 1));
	weaponPref.Close();
	return itemDefIndex;
}

stock void SetWeaponPreference(int client, const char[] class, const char[] slot, int value)
{
	char steamID[512];
	GetClientAuthId(client, steamID, 512, AuthId_Steam3);
	m_kvPlayerPrefData.JumpToKey(steamID, true);
	m_kvPlayerPrefData.JumpToKey("loadout", true);
	m_kvPlayerPrefData.JumpToKey(class, true);
	m_kvPlayerPrefData.SetNum(slot, value);
	m_kvPlayerPrefData.Rewind();
}

stock bool IsValidForBotPreferences(int client)
{
	return !IsFakeClient(client) && (TF2_GetClientTeam(client) == TFTeam_Red);
}

stock void CollectPlayerBotClassPreferences(ArrayList stringList)
{
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && IsValidForBotPreferences(i))
		{
			int classFlags = GetClassPreferencesFlags(i);
			if ((classFlags & PREF_FL_SCOUT) != 0)
			{
				stringList.PushString("scout");
			}
			if ((classFlags & PREF_FL_SOLDIER) != 0)
			{
				stringList.PushString("soldier");
			}
			if ((classFlags & PREF_FL_PYRO) != 0)
			{
				stringList.PushString("pyro");
			}
			if ((classFlags & PREF_FL_DEMO) != 0)
			{
				stringList.PushString("demoman");
			}
			if ((classFlags & PREF_FL_HEAVY) != 0)
			{
				stringList.PushString("heavyweapons");
			}
			if ((classFlags & PREF_FL_ENGINEER) != 0)
			{
				stringList.PushString("engineer");
			}
			if ((classFlags & PREF_FL_MEDIC) != 0)
			{
				stringList.PushString("medic");
			}
			if ((classFlags & PREF_FL_SNIPER) != 0)
			{
				stringList.PushString("sniper");
			}
			if ((classFlags & PREF_FL_SPY) != 0)
			{
				stringList.PushString("spy");
			}
		}
	}
}

stock void AddBotsBasedOnPreferences(int amount)
{
	if (IsServerFull())
	{
		return;
	}
	PrintToChatAll("%s Adding %d bot(s)...", PLUGIN_PREFIX, amount);
	if (amount <= 0)
	{
		return;
	}
	ArrayList classPref = new ArrayList(TF2_CLASS_MAX_NAME_LENGTH);
	CollectPlayerBotClassPreferences(classPref);
	if (classPref.Length > 0)
	{
		for (int i = 1; i <= amount; i++)
		{
			char class[512];
			classPref.GetString(GetRandomInt(0, classPref.Length - 1), class, 512);
			AddDefenderTFBot(1, class, "red", "expert");
		}
	}
	else
	{
		AddRandomDefenderBots(amount);
	}
	classPref.Close();
}

