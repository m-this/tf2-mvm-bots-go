stock void CreateDisplayPanelBotPercentages(int client, const float classPercents[9], const int duration = 30)
{
	if (IsFakeClient(client))
	{
		return;
	}
	Panel hPanel = new Panel();
	hPanel.SetTitle("Defender Bot Class Chances");
	for (int i = 0; i < 9; i++)
	{
		if (classPercents[i] > 0.0)
		{
			char itemText[512];
			Format(itemText, 512, "%s: %.0f%%", PANEL_CLASS_NAMES[i], classPercents[i]);
			hPanel.DrawItem(itemText);
		}
	}
	hPanel.Send(client, MenuHandler_ShowBotChances, duration);
	delete hPanel;
}

stock bool CreateDisplayPanelBotTeamComposition(int client, const int duration = 30)
{
	if (g_adtChosenBotClasses.Length == 0)
	{
		return false;
	}
	Panel hPanel = new Panel();
	hPanel.SetTitle("Current Bot Lineup");
	for (int i = 0; i < g_adtChosenBotClasses.Length; i++)
	{
		char itemText[512];
		g_adtChosenBotClasses.GetString(i, itemText, 512);
		hPanel.DrawItem(itemText);
	}
	bool bSuccess = hPanel.Send(client, MenuHandler_ShowBotTeamComposition, duration);
	delete hPanel;
	return bSuccess;
}

