/* Generated by internal/spbody from the Go it is named after. Do not edit. */

// DoesAnyPlayerUseThisName says somebody on the server is already called that,
// which is how a bot avoids taking a player's name.
stock bool DoesAnyPlayerUseThisName(const char[] name)
{
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!IsClientConnected(i))
		{
			continue;
		}
		char playerName[512];
		bool named = GetClientName(i, playerName, 512);
		if (named && StrEqual(playerName, name, false))
		{
			return true;
		}
	}
	return false;
}

// NormalizeAngle folds an angle into the half turn either side of zero, which is
// the shortest way round.
stock float NormalizeAngle(float angle)
{
	angle = angle - (float(RoundToFloor(angle / 360.0)) * 360.0);
	if (angle > 180.0)
	{
		angle -= 360.0;
	}
	else
		if (angle < -180.0)
		{
			angle += 360.0;
		}
	return angle;
}

// SnapViewToPosition turns the bot's head to look at a point, at once rather than
// over time.
stock void SnapViewToPosition(int client, const float pos[3])
{
	float clientEyePos[3];
	GetClientEyePosition(client, clientEyePos);
	float desiredDir[3];
	MakeVectorFromPoints(clientEyePos, pos, desiredDir);
	GetVectorAngles(desiredDir, desiredDir);
	float clientEyeAng[3];
	GetClientEyeAngles(client, clientEyeAng);
	float eyeAngles[3];
	eyeAngles[0] = clientEyeAng[0] + NormalizeAngle(desiredDir[0] - clientEyeAng[0]);
	eyeAngles[1] = clientEyeAng[1] + NormalizeAngle(desiredDir[1] - clientEyeAng[1]);
	eyeAngles[2] = 0.0;
	TeleportEntity(client, NULL_VECTOR, eyeAngles, NULL_VECTOR);
}

// IsValidClientIndex says the number is a client that is actually here.
stock bool IsValidClientIndex(int client)
{
	return (client > 0) && (client <= MaxClients) && IsClientInGame(client);
}

// IsBaseBoss says the entity is a tank, which is the one thing carrying that
// property.
stock bool IsBaseBoss(int entity)
{
	return HasEntProp(entity, Prop_Send, "m_lastHealthPercentage");
}

// IsPlayerReady says the player has pressed ready, which is what holds a wave.
stock bool IsPlayerReady(int client)
{
	return GameRules_GetProp("m_bPlayerReady", 1, client) != 0;
}

// IsMeleeWeapon says the weapon swings rather than fires.
stock bool IsMeleeWeapon(int entity)
{
	// THINKFUNC Smack
	return HasEntProp(entity, Prop_Data, "CTFWeaponBaseMeleeSmack");
}

// IsZeroVector says the position is the origin, which is what an unset one reads
// as.
stock bool IsZeroVector(float origin[3])
{
	return (origin[0] == NULL_VECTOR[0]) && (origin[1] == NULL_VECTOR[1]) && (origin[2] == NULL_VECTOR[2]);
}

// SetPlayerReady presses ready for the bot, when it is not already pressed.
stock void SetPlayerReady(int client, bool state)
{
	if (IsPlayerReady(client) == state)
	{
		return;
	}
	FakeClientCommand(client, "tournament_player_readystate %d", state);
}

// UseActionSlotItem uses the canteen, which the game takes as key values rather
// than as a command.
stock void UseActionSlotItem(int client)
{
	KeyValues kv = new KeyValues("use_action_slot_item_server");
	FakeClientCommandKeyValues(client, kv);
	delete kv;
}

// PlayerBuyback spends the credits that put a dead bot back in the wave.
stock void PlayerBuyback(int client)
{
	FakeClientCommand(client, "td_buyback");
}

// IsServerFull says there is no seat left.
stock bool IsServerFull()
{
	return GetClientCount(false) >= MaxClients;
}

// GetTeamHumanClientCount is how many people, rather than bots, are on that team.
stock int GetTeamHumanClientCount(int team)
{
	int count = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (IsClientInGame(i) && !IsFakeClient(i) && (GetClientTeam(i) == team))
		{
			count++;
		}
	}
	return count;
}

// TEMPGetPlayerMaxHealth is the player's maximum, read off the resource entity
// because the player's own property lags a class change. The shipped name says
// TEMP_ and has for years.
stock int TEMP_GetPlayerMaxHealth(int client)
{
	return GetEntProp(GetPlayerResourceEntity(), Prop_Send, "m_iMaxHealth", 4, client);
}

