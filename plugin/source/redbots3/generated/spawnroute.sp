/* Generated by internal/spbody from the Go it is named after. Do not edit. */

// NearestSpawnPoint is where this bot's team respawns, and false when the map
// names no such thing.
stock bool NearestSpawnPoint(int actor, float spawn[3])
{
	for (int i = 0; i < 3; i++)
	{
		spawn[i] = 0.0;
	}
	int point = -1;
	int nearest = -1;
	float nearestRange = -1.0;
	for (;;)
	{
		point = FindEntityByClassname(point, "info_player_teamspawn");
		if (point == -1)
		{
			break;
		}
		if (GetEntProp(point, Prop_Data, "m_iTeamNum") != view_as<int>(TFTeam_Red))
		{
			continue;
		}
		float origin[3];
		GetEntPropVector(point, Prop_Data, "m_vecAbsOrigin", origin);
		float pointRange = GetVectorDistance(GetAbsOrigin(actor), origin);
		if ((nearestRange < 0.0) || (pointRange < nearestRange))
		{
			nearestRange = pointRange;
			nearest = point;
		}
	}
	if (nearest == -1)
	{
		return false;
	}
	GetEntPropVector(nearest, Prop_Data, "m_vecAbsOrigin", spawn);
	return true;
}

// Points samples the way out of spawn: where a teleporter goes, and where
// the man stands to put it there, one pair per step along the route.
//
// Returns how many points the route was long enough for, which is none when there is
// no route at all and none when the engineer is already inside the spawn room.
stock int SpawnRoutePoints(int actor, const float spawn[3], float first, float step, float reach, float spots[][3], float stands[][3], int pointsMax)
{
	CBaseCombatCharacter(actor).UpdateLastKnownArea();
	PathFollower route = PathFollower(_, Path_FilterIgnoreActors, Path_FilterOnlyActors);
	int found = 0;
	if (route.ComputeToPos(CBaseNPC_GetNextBotOfEntity(actor), spawn))
	{
		float length = route.GetLength();
		for (int i = 0; i < pointsMax; i++)
		{
			float fromSpawn = first + (step * float(i));
			// The route runs out, and a point past the far end of it is not on the way out of spawn
			if (length <= (fromSpawn + reach))
			{
				break;
			}
			route.GetPosition(length - fromSpawn, spots[i]);
			route.GetPosition(length - fromSpawn - reach, stands[i]);
			found++;
		}
	}
	route.Destroy();
	return found;
}

// Out samples the same way out of spawn from its near end: the route from where he
// stands, in spawn, to the nest. The spot is first + step*i along it, and the stand
// is a build's reach short of the spot on the spawn side, which is the side he
// arrives from when the entrance goes up before the nest.
//
// Returns how many points the route was long enough for, which is none when there is
// no route to the nest.
stock int SpawnRouteOut(int actor, const float nest[3], float first, float step, float reach, float spots[][3], float stands[][3], int pointsMax)
{
	CBaseCombatCharacter(actor).UpdateLastKnownArea();
	PathFollower route = PathFollower(_, Path_FilterIgnoreActors, Path_FilterOnlyActors);
	int found = 0;
	if (route.ComputeToPos(CBaseNPC_GetNextBotOfEntity(actor), nest))
	{
		float length = route.GetLength();
		for (int i = 0; i < pointsMax; i++)
		{
			float fromSpawn = first + (step * float(i));
			// A point past the nest is not on the way out of spawn
			if (length <= fromSpawn)
			{
				break;
			}
			route.GetPosition(fromSpawn, spots[i]);
			route.GetPosition(fromSpawn - reach, stands[i]);
			found++;
		}
	}
	route.Destroy();
	return found;
}

