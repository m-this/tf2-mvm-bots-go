/* Generated by internal/spbody from the Go it is named after. Do not edit. */

stock bool NearestSpawnPoint(int actor, float spawn[3])
{
	for (int i = 0; i < 3; i++)
	{
		spawn[i] = 0.0;
	}
	int point = -1;
	int nearest = -1;
	float nearestRange = -1.0;
	for (;;)
	{
		point = FindEntityByClassname(point, "info_player_teamspawn");
		if (point == -1)
		{
			break;
		}
		if (GetEntProp(point, Prop_Data, "m_iTeamNum") != view_as<int>(TFTeam_Red))
		{
			continue;
		}
		float origin[3];
		GetEntPropVector(point, Prop_Data, "m_vecAbsOrigin", origin);
		float pointRange = GetVectorDistance(GetAbsOrigin(actor), origin);
		if ((nearestRange < 0.0) || (pointRange < nearestRange))
		{
			nearestRange = pointRange;
			nearest = point;
		}
	}
	if (nearest == -1)
	{
		return false;
	}
	GetEntPropVector(nearest, Prop_Data, "m_vecAbsOrigin", spawn);
	return true;
}

stock int SpawnRoutePoints(int actor, const float spawn[3], float first, float step, float reach, float spots[][3], float stands[][3], int pointsMax)
{
	CBaseCombatCharacter(actor).UpdateLastKnownArea();
	PathFollower route = PathFollower(_, Path_FilterIgnoreActors, Path_FilterOnlyActors);
	int found = 0;
	if (route.ComputeToPos(CBaseNPC_GetNextBotOfEntity(actor), spawn))
	{
		float length = route.GetLength();
		for (int i = 0; i < pointsMax; i++)
		{
			float fromSpawn = first + (step * float(i));
			if (length <= (fromSpawn + reach))
			{
				break;
			}
			route.GetPosition(length - fromSpawn, spots[i]);
			route.GetPosition(length - fromSpawn - reach, stands[i]);
			found++;
		}
	}
	route.Destroy();
	return found;
}

