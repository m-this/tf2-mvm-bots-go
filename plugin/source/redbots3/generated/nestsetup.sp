/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define SETUP_SENTRY (0)
#define SETUP_DISPENSER (1)
#define SETUP_ENTRANCE (2)
#define SETUP_EXIT (3)
#define SETUP_SPOTS (4)

#define SETUP_SPOT_SPACING (200.0)

#define SETUP_UPGRADE_COST (200)

#define SETUP_JUMPS_MAX (8)

float m_vSetupClaim[65][4][3];
bool m_bSetupClaimed[65][4];
int m_iSetupJumps[65];

stock void Go_ResetNestSetup(int client)
{
	for (int what = 0; what < SETUP_SPOTS; what++)
	{
		m_bSetupClaimed[client][what] = false;
	}
	m_iSetupJumps[client] = 0;
}

stock void ForgetSetupPlans()
{
	for (int i = 1; i <= MaxClients; i++)
	{
		Go_ResetNestSetup(i);
	}
}

stock void ClaimSetupSpot(int client, int what, const float spot[3])
{
	if ((what < 0) || (what >= SETUP_SPOTS))
	{
		return;
	}
	m_vSetupClaim[client][what] = spot;
	m_bSetupClaimed[client][what] = true;
}

stock bool IsSetupSpotClaimed(int client, const float spot[3])
{
	for (int i = 1; i <= MaxClients; i++)
	{
		if ((i == client) || !IsClientInGame(i))
		{
			continue;
		}
		for (int what = 0; what < SETUP_SPOTS; what++)
		{
			if (!m_bSetupClaimed[i][what])
			{
				continue;
			}
			if (GetVectorDistance(spot, m_vSetupClaim[i][what]) < SETUP_SPOT_SPACING)
			{
				return true;
			}
		}
	}
	return false;
}

stock bool SetupJump(int client, const float spot[3])
{
	if (GameRules_GetRoundState() != RoundState_BetweenRounds)
	{
		return false;
	}
	if (!IsClientInGame(client) || !IsPlayerAlive(client))
	{
		return false;
	}
	if ((TF2_GetPlayerClass(client) != TFClass_Engineer) || !g_bIsDefenderBot[client])
	{
		return false;
	}
	if (m_iSetupJumps[client] >= SETUP_JUMPS_MAX)
	{
		return false;
	}
	float destination[3];
	destination = spot;
	destination[2] += TFBOT_STEP_HEIGHT;
	if (!IsRoomToStand(destination))
	{
		return false;
	}
	m_iSetupJumps[client]++;
	CBaseEntity(client).SetAbsOrigin(destination);
	return true;
}

stock void TopUpUpgrades(int client)
{
	if (!Feature(FEATURE_ENGINEER_SETUP_PHASE))
	{
		return;
	}
	if (GameRules_GetRoundState() != RoundState_BetweenRounds)
	{
		return;
	}
	if (!g_bIsDefenderBot[client])
	{
		return;
	}
	TopUpBuilding(GetObjectOfType(client, TFObject_Sentry));
	TopUpBuilding(GetObjectOfType(client, TFObject_Dispenser));
	TopUpBuilding(GetObjectOfType(client, TFObject_Teleporter, TFObjectMode_Entrance));
	TopUpBuilding(GetObjectOfType(client, TFObject_Teleporter, TFObjectMode_Exit));
}

stock void TopUpBuilding(int building)
{
	if ((building == INVALID_ENT_REFERENCE) || !IsValidEntity(building))
	{
		return;
	}
	if (TF2_IsMiniBuilding(building) || TF2_IsBuilding(building))
	{
		return;
	}
	if (TF2_GetUpgradeLevel(building) >= TF2_GetMaxUpgradeLevel())
	{
		return;
	}
	SetEntProp(building, Prop_Send, "m_iUpgradeMetal", SETUP_UPGRADE_COST);
}

