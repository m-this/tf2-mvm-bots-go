/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define Go_Attributes (20)

stock void ShowUpgradesOn(int client, int entity, const char[] what)
{
	int attribIndexes[20];
	int count = TF2Attrib_ListDefIndices(entity, attribIndexes);
	ReplyToCommand(client, "%s: %d upgrades", what, count);
	for (int i = 0; i < count; i++)
	{
		Address pAttr = TF2Attrib_GetByDefIndex(entity, attribIndexes[i]);
		float value = TF2Attrib_GetValue(pAttr);
		char name[512];
		bool ok = TF2Econ_GetAttributeName(attribIndexes[i], name, 512);
		if (!ok)
		{
			strcopy(name, 128, "(unnamed)");
		}
		ReplyToCommand(client, "  %-48s %.3f", name, value);
	}
}

stock void ShowPlayerUpgrades(int client, int target, int slot)
{
	char who[512];
	GetClientName(target, who, 512);
	if (slot == -1)
	{
		char label[512];
		FormatEx(label, 512, "%s, on himself", who);
		ShowUpgradesOn(client, target, label);
		return;
	}
	int weapon = GetPlayerWeaponSlot(target, slot);
	if (weapon == -1)
	{
		ReplyToCommand(client, "%s has nothing in slot %d.", who, slot);
		return;
	}
	char label[512];
	FormatEx(label, 512, "%s, slot %d", who, slot);
	ShowUpgradesOn(client, weapon, label);
}

