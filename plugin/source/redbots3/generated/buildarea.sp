/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define NEST_HATCH_CLEARANCE (180.0)

stock CNavArea PickBuildArea(int client, float sentryRange = 1300.0)
{
	int areaCount = TheNavAreas.Count;
	if (areaCount <= 0)
	{
		return NULL_AREA;
	}
	BombInfo_t bombinfo;
	bool found = GetBombInfo(bombinfo);
	if (!found)
	{
		return PickBuildAreaPreRound(client, 1300.0);
	}
	float targetPos[3];
	targetPos[0] = bombinfo.vPosition[0];
	targetPos[1] = bombinfo.vPosition[1];
	targetPos[2] = bombinfo.vPosition[2] + 40.0;
	CNavArea configured = PickConfiguredNestArea(client, targetPos, sentryRange);
	if (configured != NULL_AREA)
	{
		return configured;
	}
	CNavArea hinted = PickMapHintNestArea(client, targetPos, sentryRange);
	if (hinted != NULL_AREA)
	{
		return hinted;
	}
	CTFNavArea bombArea = view_as<CTFNavArea>(TheNavMesh.GetNearestNavArea(targetPos, false, 90000.0, false, true, TEAM_ANY));
	if (bombArea == view_as<CTFNavArea>(NULL_AREA))
	{
		return NULL_AREA;
	}
	if (bombArea.HasAttributeTF(BLUE_SPAWN_ROOM) || bombArea.HasAttributeTF(RED_SPAWN_ROOM))
	{
		return NULL_AREA;
	}
	ArrayList forwardVisibleAreas = new ArrayList();
	ArrayList forwardAreas = new ArrayList();
	ArrayList visibleAreasAround = new ArrayList();
	ArrayList areasTooFarUp = new ArrayList();
	ArrayList areasTooClose = new ArrayList();
	float limit = NestDistanceLimit();
	for (int i = 0; i < areaCount; i++)
	{
		CTFNavArea area = TheNavAreas.Get(i);
		if (area == view_as<CTFNavArea>(NULL_AREA))
		{
			continue;
		}
		if (area.HasAttributeTF(BLUE_SPAWN_ROOM) || area.HasAttributeTF(RED_SPAWN_ROOM))
		{
			continue;
		}
		if (area.HasAttributeTF(BLOCKED))
		{
			continue;
		}
		if (!area.HasAttributeTF(BOMB_DROP))
		{
			continue;
		}
		float bombTargetDistanceAtArea = GetTravelDistanceToBombTarget(view_as<CNavArea>(area));
		float bombTargetDistanceAtBomb = GetTravelDistanceToBombTarget(view_as<CNavArea>(bombArea));
		if (bombTargetDistanceAtArea < NEST_HATCH_CLEARANCE)
		{
			continue;
		}
		if ((limit > 0.0) && (bombTargetDistanceAtArea > limit))
		{
			areasTooFarUp.Push(view_as<int>(area));
			continue;
		}
		float areaCenter[3];
		area.GetCenter(areaCenter);
		areaCenter[2] += 50.0;
		float areaDistanceToBomb = GetVectorDistance(areaCenter, targetPos);
		if (areaDistanceToBomb >= sentryRange)
		{
			continue;
		}
		if (!IsNestRangeSane(areaDistanceToBomb, sentryRange))
		{
			areasTooClose.Push(view_as<int>(area));
			continue;
		}
		bool areaVisibleToBomb = area.IsEntirelyVisible(targetPos);
		if (areaVisibleToBomb)
		{
			visibleAreasAround.Push(view_as<int>(area));
		}
		if (bombTargetDistanceAtBomb > bombTargetDistanceAtArea)
		{
			if ((areaDistanceToBomb <= (sentryRange * GetRandomFloat(0.8, 1.75))) && areaVisibleToBomb)
			{
				forwardVisibleAreas.Push(view_as<int>(area));
			}
			forwardAreas.Push(view_as<int>(area));
		}
	}
	CNavArea randomArea = NULL_AREA;
	if (forwardVisibleAreas.Length > 0)
	{
		randomArea = BestNestArea(client, forwardVisibleAreas, targetPos, sentryRange);
	}
	else
		if (forwardAreas.Length > 0)
		{
			randomArea = BestNestArea(client, forwardAreas, targetPos, sentryRange);
		}
		else
			if (visibleAreasAround.Length > 0)
			{
				randomArea = BestNestArea(client, visibleAreasAround, targetPos, sentryRange);
			}
			else
				if (areasTooFarUp.Length > 0)
				{
					randomArea = BestNestArea(client, areasTooFarUp, targetPos, sentryRange);
				}
				else
					if (areasTooClose.Length > 0)
					{
						randomArea = BestNestArea(client, areasTooClose, targetPos, sentryRange);
					}
	if (redbots_manager_debug.BoolValue)
	{
		PrintToServer("PickBuildArea %i ForwardVisibleAreas | %i ForwardAreas | %i VisibleAreasAroundBomb | %i AreasTooFarUp | %i AreasTooClose", forwardVisibleAreas.Length, forwardAreas.Length, visibleAreasAround.Length, areasTooFarUp.Length, areasTooClose.Length);
	}
	delete areasTooClose;
	delete areasTooFarUp;
	delete visibleAreasAround;
	delete forwardAreas;
	delete forwardVisibleAreas;
	return randomArea;
}

stock CNavArea PickBuildAreaPreRound(int client, float sentryRange = 1300.0)
{
	int areaCount = TheNavAreas.Count;
	if (areaCount <= 0)
	{
		return NULL_AREA;
	}
	float limit = NestDistanceLimit();
	float hatch[3];
	hatch = GetBombHatchPosition();
	hatch[2] += 40.0;
	CNavArea configured = PickConfiguredNestArea(client, hatch, sentryRange);
	if (configured != NULL_AREA)
	{
		return configured;
	}
	CNavArea hinted = PickMapHintNestArea(client, hatch, sentryRange);
	if (hinted != NULL_AREA)
	{
		return hinted;
	}
	ArrayList coveringAreas = new ArrayList();
	ArrayList nestingAreas = new ArrayList();
	ArrayList areasTooFarUp = new ArrayList();
	ArrayList areasTooClose = new ArrayList();
	for (int i = 0; i < areaCount; i++)
	{
		CTFNavArea area = TheNavAreas.Get(i);
		if (area == view_as<CTFNavArea>(NULL_AREA))
		{
			continue;
		}
		if (area.HasAttributeTF(BLUE_SPAWN_ROOM) || area.HasAttributeTF(RED_SPAWN_ROOM))
		{
			continue;
		}
		if (area.HasAttributeTF(BLOCKED))
		{
			continue;
		}
		if (!area.HasAttributeTF(BOMB_DROP))
		{
			continue;
		}
		float distance = GetTravelDistanceToBombTarget(view_as<CNavArea>(area));
		if (distance < NEST_HATCH_CLEARANCE)
		{
			continue;
		}
		if ((limit > 0.0) && (distance > limit))
		{
			areasTooFarUp.Push(view_as<int>(area));
			continue;
		}
		float center[3];
		area.GetCenter(center);
		center[2] += 50.0;
		if (!IsNestRangeSane(GetVectorDistance(center, hatch), sentryRange))
		{
			areasTooClose.Push(view_as<int>(area));
			continue;
		}
		nestingAreas.Push(view_as<int>(area));
		if (area.IsEntirelyVisible(hatch))
		{
			coveringAreas.Push(view_as<int>(area));
		}
	}
	CNavArea bestArea = NULL_AREA;
	if (coveringAreas.Length > 0)
	{
		bestArea = BestNestArea(client, coveringAreas, hatch, sentryRange);
	}
	else
		if (nestingAreas.Length > 0)
		{
			bestArea = BestNestArea(client, nestingAreas, hatch, sentryRange);
		}
		else
			if (areasTooFarUp.Length > 0)
			{
				bestArea = BestNestArea(client, areasTooFarUp, hatch, sentryRange);
			}
			else
				if (areasTooClose.Length > 0)
				{
					bestArea = BestNestArea(client, areasTooClose, hatch, sentryRange);
				}
	if (redbots_manager_debug.BoolValue)
	{
		PrintToServer("PickBuildAreaPreRound %i CoveringAreas | %i NestingAreas | %i AreasTooFarUp | %i AreasTooClose", coveringAreas.Length, nestingAreas.Length, areasTooFarUp.Length, areasTooClose.Length);
	}
	delete areasTooClose;
	delete areasTooFarUp;
	delete nestingAreas;
	delete coveringAreas;
	return bestArea;
}

