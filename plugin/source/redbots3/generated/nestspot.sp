/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define NEST_SPOT_MATCH_RANGE (400.0)

#define BUILD_STAND_SEARCH (120.0)
#define BUILD_STAND_STOREY (100.0)

stock void NestBuildPosition(CNavArea area, float out[3])
{
	for (int i = 0; i < 3; i++)
	{
		out[i] = 0.0;
	}
	if (area == NULL_AREA)
	{
		out[0] = 0.0;
		out[1] = 0.0;
		out[2] = 0.0;
		return;
	}
	area.GetCenter(out);
	float best = 400.0;
	float closest;
	float nearest[3];
	NestSpotFromList(g_arrMapConfig.adtEngineerNestLocation, out, best, nearest, closest);
	out = nearest;
	best = closest;
	NestSpotFromList(g_arrMapConfig.adtNestTankOnlyLocation, out, best, nearest, closest);
	out = nearest;
	best = closest;
	NestSpotFromList(g_arrMapConfig.adtNestNoTankLocation, out, best, nearest, closest);
	out = nearest;
	return;
}

stock void NestSpotFromList(ArrayList spots, float inout[3], float best, float out[3], float &closest)
{
	for (int i = 0; i < 3; i++)
	{
		out[i] = 0.0;
	}
	closest = 0.0;
	float centre[3];
	centre = inout;
	out = inout;
	closest = best;
	for (int i = 0; i < spots.Length; i++)
	{
		float spot[3];
		spots.GetArray(i, spot);
		float distance = GetVectorDistance(centre, spot);
		if (distance < closest)
		{
			closest = distance;
			out = spot;
		}
	}
	return;
}

stock void NestZoneOf(CNavArea area, char[] zone, int maxlength)
{
	zone[0] = 0;
	if (area == NULL_AREA)
	{
		return;
	}
	ArrayList spots = g_arrMapConfig.adtEngineerNestLocation;
	ArrayList zones = g_arrMapConfig.adtEngineerNestZone;
	float centre[3];
	area.GetCenter(centre);
	float best = 400.0;
	for (int i = 0; (i < spots.Length) && (i < zones.Length); i++)
	{
		float spot[3];
		spots.GetArray(i, spot);
		float distance = GetVectorDistance(centre, spot);
		if (distance < best)
		{
			best = distance;
			zones.GetString(i, zone, 512);
		}
	}
}

stock bool BuildStandPoint(const float spot[3], const float from[3], int attempt, int attempts, float reach, float stand[3])
{
	for (int i = 0; i < 3; i++)
	{
		stand[i] = 0.0;
	}
	float away[3];
	SubtractVectors(from, spot, away);
	away[2] = 0.0;
	float length = NormalizeVector(away, away);
	if (length < 1.0)
	{
		away[0] = 1.0;
		away[1] = 0.0;
	}
	float yaw = ArcTangent2(away[1], away[0]) + DegToRad((360.0 / float(attempts)) * float(attempt));
	stand[0] = spot[0] + (Cosine(yaw) * reach);
	stand[1] = spot[1] + (Sine(yaw) * reach);
	stand[2] = spot[2];
	CNavArea area = TheNavMesh.GetNearestNavArea(stand, false, BUILD_STAND_SEARCH, false, true, TEAM_ANY);
	if (area == NULL_AREA)
	{
		return false;
	}
	float ground[3];
	area.GetClosestPointOnArea(stand, ground);
	if (FloatAbs(ground[2] - spot[2]) > BUILD_STAND_STOREY)
	{
		return false;
	}
	stand = ground;
	return true;
}

stock void CNavArea_GetRandomPoint(CNavArea area, float buffer[3])
{
	for (int i = 0; i < 3; i++)
	{
		buffer[i] = 0.0;
	}
	float eHi[3];
	float eLo[3];
	area.GetExtent(eLo, eHi);
	float spot[3];
	spot[0] = GetRandomFloat(eLo[0], eHi[0]);
	spot[1] = GetRandomFloat(eLo[1], eHi[1]);
	spot[2] = area.GetZ(spot[0], spot[1]);
	buffer = spot;
	return;
}

