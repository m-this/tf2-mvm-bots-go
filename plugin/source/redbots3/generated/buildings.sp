/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define MAX_PLAYER_OBJECTS (8)

stock bool IsBuilderSetTo(int client, TFObjectType objectType, TFObjectMode mode = TFObjectMode_None)
{
	int weapon = BaseCombatCharacter_GetActiveWeapon(client);
	if ((weapon < 1) || (TF2Util_GetWeaponID(weapon) != TF_WEAPON_BUILDER))
	{
		return false;
	}
	if (GetEntProp(weapon, Prop_Send, "m_iObjectType") != view_as<int>(objectType))
	{
		return false;
	}
	if ((objectType == TFObject_Teleporter) && (GetEntProp(weapon, Prop_Send, "m_iObjectMode") != view_as<int>(mode)))
	{
		return false;
	}
	return true;
}

stock int PlayerObjectCount(int client)
{
	if ((client <= 0) || (client > MaxClients) || !IsClientInGame(client))
	{
		return 0;
	}
	return TF2Util_GetPlayerObjectCount(client);
}

stock void DetonateObjectOfType(int client, TFObjectType objectType, TFObjectMode mode = TFObjectMode_None, bool ignoreSapperState = false)
{
	int found[8];
	int count = 0;
	int numObjects = PlayerObjectCount(client);
	for (int i = 0; (i < numObjects) && (count < MAX_PLAYER_OBJECTS); i++)
	{
		int obj = TF2Util_GetPlayerObject(client, i);
		if (TF2_GetObjectType(obj) != objectType)
		{
			continue;
		}
		if ((objectType == TFObject_Teleporter) && (TF2_GetObjectMode(obj) != mode))
		{
			continue;
		}
		if (TF2_IsDisposableBuilding(obj))
		{
			continue;
		}
		if (!ignoreSapperState && (TF2_HasSapper(obj) || TF2_IsPlasmaDisabled(obj)))
		{
			continue;
		}
		found[count] = EntIndexToEntRef(obj);
		count++;
	}
	for (int i = 0; i < count; i++)
	{
		int obj = EntRefToEntIndex(found[i]);
		if ((obj == INVALID_ENT_REFERENCE) || !IsValidEntity(obj))
		{
			continue;
		}
		Event event = CreateEvent("object_removed");
		if (event != null)
		{
			event.SetInt("userid", GetClientUserId(client));
			event.SetInt("objecttype", view_as<int>(objectType));
			event.SetInt("index", obj);
			event.Fire();
		}
		TF2_DetonateObject(obj);
	}
}

stock int HasObjectOfType(int client, TFObjectType objectType, TFObjectMode mode = TFObjectMode_None)
{
	int standing = GetObjectOfType(client, objectType, mode);
	if (standing != INVALID_ENT_REFERENCE)
	{
		return standing;
	}
	int carried = TF2_GetCarriedObject(client);
	if ((carried == -1) || !IsValidEntity(carried))
	{
		return INVALID_ENT_REFERENCE;
	}
	if (TF2_GetObjectType(carried) != objectType)
	{
		return INVALID_ENT_REFERENCE;
	}
	if ((objectType == TFObject_Teleporter) && (TF2_GetObjectMode(carried) != mode))
	{
		return INVALID_ENT_REFERENCE;
	}
	return carried;
}

stock int GetObjectOfType(int client, TFObjectType objectType, TFObjectMode mode = TFObjectMode_None)
{
	int numObjects = PlayerObjectCount(client);
	for (int i = 0; i < numObjects; i++)
	{
		int obj = TF2Util_GetPlayerObject(client, i);
		if (TF2_GetObjectType(obj) != objectType)
		{
			continue;
		}
		if ((objectType == TFObject_Teleporter) && (TF2_GetObjectMode(obj) != mode))
		{
			continue;
		}
		if (TF2_IsDisposableBuilding(obj))
		{
			continue;
		}
		return obj;
	}
	return -1;
}

stock void LogBuildFailure(int actor, const char[] what, const char[] why)
{
	if ((actor < 1) || (actor > MaxClients) || !IsClientInGame(actor))
	{
		return;
	}
	PrintToServer("[defenderbots] %s failed for %N at %.1f: %s", what, actor, GetGameTime(), why);
	LogMessage("Build: %s for %N at %.1f: %s", what, actor, GetGameTime(), why);
}

