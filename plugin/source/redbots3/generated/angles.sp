/* Generated by internal/spbody from the Go it is named after. Do not edit. */

stock float AngleNormalize(float angle)
{
	angle = angle - (360.0 * float(RoundToFloor(angle / 360.0)));
	while (angle > 180.0)
	{
		angle -= 360.0;
	}
	while (angle < -180.0)
	{
		angle += 360.0;
	}
	return angle;
}

stock float AngleDiff(float destAngle, float srcAngle)
{
	return AngleNormalize(destAngle - srcAngle);
}

stock float ApproachAngle(float target, float value, float speed)
{
	float delta = AngleDiff(target, value);
	if (speed < 0.0)
	{
		speed = -speed;
	}
	if (delta > speed)
	{
		value += speed;
	}
	else
		if (delta < -speed)
		{
			value -= speed;
		}
		else
		{
			value = target;
		}
	return AngleNormalize(value);
}

stock float[] GetAbsVelocity(int entity)
{
	float vec[3];
	CBaseEntity(entity).GetAbsVelocity(vec);
	return vec;
}

stock float[] GetEyePosition(int client)
{
	float vec[3];
	BaseEntity_EyePosition(client, vec);
	return vec;
}

stock float VMX_VectorNormalize(float a1[3])
{
	float length = GetVectorLength(a1, true) + 1.0e-10;
	float v4 = 1.0 / SquareRoot(length);
	float den = v4 * ((3.0 - ((v4 * v4) * length)) * 0.5);
	ScaleVector(a1, den);
	return den * length;
}

