/* Generated by internal/spbody from the Go it is named after. Do not edit. */

stock bool GetBombInfo(BombInfo_t info)
{
	int areaCount = TheNavAreas.Count;
	if (areaCount <= 0)
	{
		return false;
	}
	float hatchDist = 0.0;
	for (int i = 0; i < (areaCount - 1); i++)
	{
		CTFNavArea area = TheNavAreas.Get(i);
		if (area.HasAttributeTF(BLUE_SPAWN_ROOM) || area.HasAttributeTF(RED_SPAWN_ROOM))
		{
			continue;
		}
		float bombTargetDistance = GetTravelDistanceToBombTarget(view_as<CNavArea>(area));
		hatchDist = MaxFloat(MaxFloat(bombTargetDistance, hatchDist), 0.0);
	}
	int closestFlag = INVALID_ENT_REFERENCE;
	float closestFlagPos[3];
	int flag = -1;
	for (;;)
	{
		flag = FindEntityByClassname(flag, "item_teamflag");
		if (flag == -1)
		{
			break;
		}
		if (GetEntProp(flag, Prop_Send, "m_nFlagStatus") == TF_FLAGINFO_HOME)
		{
			continue;
		}
		float flagPos[3];
		int owner = BaseEntity_GetOwnerEntity(flag);
		if (IsValidClientIndex(owner))
		{
			flagPos = GetAbsOrigin(owner);
		}
		else
		{
			flagPos = WorldSpaceCenter(flag);
		}
		CTFNavArea area = view_as<CTFNavArea>(TheNavMesh.GetNearestNavArea(flagPos));
		if (area == view_as<CTFNavArea>(NULL_AREA))
		{
			continue;
		}
		if (area.HasAttributeTF(BLUE_SPAWN_ROOM) || area.HasAttributeTF(RED_SPAWN_ROOM))
		{
			continue;
		}
		float bombTargetDistance = GetTravelDistanceToBombTarget(view_as<CNavArea>(area));
		if (bombTargetDistance < hatchDist)
		{
			closestFlag = flag;
			hatchDist = bombTargetDistance;
			closestFlagPos = flagPos;
		}
	}
	float rangeFwd = 2300.0;
	float rangeBack = 1000.0;
	info.vPosition = closestFlagPos;
	info.flMaxBattleFront = hatchDist + rangeBack;
	info.flMinBattleFront = hatchDist - rangeFwd;
	return closestFlag != INVALID_ENT_REFERENCE;
}

