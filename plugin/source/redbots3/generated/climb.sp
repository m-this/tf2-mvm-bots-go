/* Generated by internal/spbody from the Go it is named after. Do not edit. */

#define CLIMB_RANGE (140.0)

#define CLIMB_TOP_REACH (40.0)

#define CLIMB_TOP_RANGE (70.0)

#define CLIMB_TOP_ON_SPOT (16.0)

#define CLIMB_STEP_HOLD (0.1)

#define CLIMB_RISE_MIN (24.0)
#define CLIMB_RISE_MAX (72.0)
#define CLIMB_INTERVAL (0.7)
#define CLIMB_HOLD (0.3)
#define CLIMB_LIMIT (6)
#define CLIMB_LIFT_LIMIT (2)
#define CLIMB_LIFT_ABOVE (90.0)

#define CLIMB_NONE (0)
#define CLIMB_BUSY (1)
#define CLIMB_LANDED (2)

float m_ctClimbAt[65];
int m_iClimbs[65];
int m_iClimbLifts[65];
bool m_bClimbLifted[65];
float m_vClimbFoot[65][3];
bool m_bClimbOnTop[65];

// ResetClimb forgets a seat's climb, which the next bot in it did not start.
stock void Go_ResetClimb(int client)
{
	ClimbBegin(client);
}

// Begin is a fresh count for a fresh spot, or for the same spot after he left it.
stock void ClimbBegin(int actor)
{
	m_ctClimbAt[actor] = 0.0;
	m_iClimbs[actor] = 0;
	m_iClimbLifts[actor] = 0;
	m_bClimbLifted[actor] = false;
	m_bClimbOnTop[actor] = false;
}

// OnTop is whether he landed on something since the last Begin.
stock bool ClimbOnTop(int actor)
{
	return m_bClimbOnTop[actor];
}

// Beside is whether he already stands level with the spot and within a jump of it,
// which is where the break's teleport puts him. A stand point taken from the mesh
// from there is the floor below, and walking to it is walking off the rock.
stock bool ClimbBeside(int actor, const float spot[3])
{
	float origin[3];
	origin = GetAbsOrigin(actor);
	float rise = spot[2] - origin[2];
	float reach[3];
	SubtractVectors(spot, origin, reach);
	reach[2] = 0.0;
	return (rise < CLIMB_RISE_MIN) && (rise > -24.0) && (GetVectorLength(reach) <= CLIMB_RANGE);
}

// AtFoot is whether he is close enough to the spot that the height, not the walk,
// is what keeps him off it: within a jump's range flat and no higher than a crouch
// jump below it. Nothing should path him from here, because the path finder has
// nothing to offer on the rock and asks the whole mesh before saying so.
stock bool ClimbAtFoot(int actor, const float spot[3])
{
	float origin[3];
	origin = GetAbsOrigin(actor);
	float rise = spot[2] - origin[2];
	float reach[3];
	SubtractVectors(spot, origin, reach);
	reach[2] = 0.0;
	return (rise > -24.0) && (rise <= CLIMB_RISE_MAX) && (GetVectorLength(reach) <= CLIMB_RANGE);
}

// MarkOnTop says he is level with the spot without having climbed: the break's
// teleport put him there. toward is the floor point beside the rock he would
// otherwise have walked to, which is the side to step back to.
stock void ClimbMarkOnTop(int actor, const float toward[3])
{
	m_bClimbOnTop[actor] = true;
	m_vClimbFoot[actor] = toward;
}

// StepBack puts him a short reach from a spot he is up beside, and is true while he
// is still moving: off it when he is standing on it, in to it when he landed far
// out.
//
// Up here the stand point is wherever he stands, because nothing on the rock is on
// the mesh: a path asked for to a point up here is a search for ground the mesh
// does not have, and that is the kind of frame the server's watchdog kills. So
// nothing is pathed and nothing is steered. He looks where he is going and presses
// forward, the way the jump does. Off the spot he goes towards the side he came
// up, which is the side the rock is known to reach to; in to it he goes straight,
// because the spot itself is on the rock.
stock bool ClimbStepBack(int actor, IBody myBody, const float spot[3])
{
	float here[3];
	SubtractVectors(GetAbsOrigin(actor), spot, here);
	here[2] = 0.0;
	float distance = NormalizeVector(here, here);
	if ((distance >= CLIMB_TOP_ON_SPOT) && (distance <= CLIMB_TOP_RANGE))
	{
		return false;
	}
	// Looking at a point past where he stops, so the walk does not stall on the aim
	float goal[3];
	if (distance > CLIMB_TOP_RANGE)
	{
		goal = spot;
	}
	else
	{
		float away[3];
		SubtractVectors(m_vClimbFoot[actor], spot, away);
		away[2] = 0.0;
		float unit[3];
		float length = NormalizeVector(away, unit);
		if (length < 1.0)
		{
			unit[0] = 1.0;
			unit[1] = 0.0;
		}
		goal[0] = spot[0] + (unit[0] * 180.0);
		goal[1] = spot[1] + (unit[1] * 180.0);
		goal[2] = spot[2];
	}
	AimHeadTowards(myBody, goal, MANDATORY, 0.2, Address_Null, "Stepping on a spot");
	if (myBody.IsHeadAimingOnTarget())
	{
		g_arrExtraButtons[actor].PressButtons(IN_FORWARD, CLIMB_STEP_HOLD);
	}
	return true;
}

// Say writes the reason behind a climb, under redbots_manager_debug_actions.
stock void ClimbSay(int actor, const char[] what, const char[] why, float rise, float flat)
{
	if (!redbots_manager_debug_actions.BoolValue)
	{
		return;
	}
	PrintToServer("[climb] %N %s %s, rise %.0f of %.0f to %.0f, out %.0f of %.0f, climb %d of %d", actor, why, what, rise, CLIMB_RISE_MIN, CLIMB_RISE_MAX, flat, CLIMB_RANGE, m_iClimbs[actor], CLIMB_LIMIT);
}

// ToSpot crouch jumps onto the ground the spot sits on, and lifts him onto it when
// the jumps run out.
//
// The stand point comes off the nav mesh, so for a spot on a rock the mesh does not
// cover it is the floor underneath: he arrives, the spot is over his head, and
// everything from down there is refused. This puts him on top instead.
//
// Once he is up, where he stands is where he stands: Landed tells the caller to keep
// it rather than recompute it. The count resets when he makes it, so falling off and
// climbing again costs another six jumps rather than none; the caller's own clocks
// bound the pair of them.
//
// The lift happens once per climb: six jumps that did not land earn it, and landing
// clears it, so falling off again starts a new six. The between-rounds setup already
// sets his origin onto the nest, so a lift mid-wave is the same move at a moment he
// has earned.
stock int ClimbToSpot(int actor, IBody myBody, float spot[3], const char[] what)
{
	if (!Feature(FEATURE_ENGINEER_CLIMBS))
	{
		return CLIMB_NONE;
	}
	float origin[3];
	origin = GetAbsOrigin(actor);
	float rise = spot[2] - origin[2];
	float reach[3];
	SubtractVectors(spot, origin, reach);
	reach[2] = 0.0;
	float out = GetVectorLength(reach);
	if (rise < CLIMB_RISE_MIN)
	{
		if ((m_iClimbs[actor] > 0) || m_bClimbLifted[actor])
		{
			// Level with it at the top of the jump is not up: Rottenburg's exit read as landed six
			// times in a row and he was on the floor below each time the next frame came round
			if (!CBaseNPC_GetNextBotOfEntity(actor).GetLocomotionInterface().IsOnGround())
			{
				return CLIMB_BUSY;
			}
			ClimbSay(actor, what, "landed at", rise, out);
			m_iClimbs[actor] = 0;
			m_ctClimbAt[actor] = 0.0;
			m_bClimbLifted[actor] = false;
			m_bClimbOnTop[actor] = true;
			return CLIMB_LANDED;
		}
		return CLIMB_NONE;
	}
	// Higher than a crouch jump is not a ledge, it is a wall, and no number of jumps will do it
	// Not a ledge but a wall, or not at the foot of it yet. Said nowhere: this is every tick of a walk
	if ((rise > CLIMB_RISE_MAX) || (out > CLIMB_RANGE))
	{
		return CLIMB_NONE;
	}
	if (m_iClimbs[actor] >= CLIMB_LIMIT)
	{
		if (m_bClimbLifted[actor] || (m_iClimbLifts[actor] >= CLIMB_LIFT_LIMIT))
		{
			ClimbSay(actor, what, "out of climbs at", rise, out);
			return CLIMB_NONE;
		}
		ClimbSay(actor, what, "lifted onto", rise, out);
		m_bClimbLifted[actor] = true;
		m_iClimbLifts[actor]++;
		m_vClimbFoot[actor] = origin;
		float up[3];
		up = spot;
		up[2] += CLIMB_LIFT_ABOVE;
		CBaseEntity(actor).SetAbsOrigin(up);
		return CLIMB_BUSY;
	}
	ClimbSay(actor, what, "climbing to", rise, out);
	m_vClimbFoot[actor] = origin;
	AimHeadTowards(myBody, spot, MANDATORY, 0.2, Address_Null, "Climbing to a spot");
	if (m_ctClimbAt[actor] > GetGameTime())
	{
		return CLIMB_BUSY;
	}
	m_ctClimbAt[actor] = GetGameTime() + CLIMB_INTERVAL;
	m_iClimbs[actor]++;
	// Forward is along where he is looking, which is the spot, so the three together are a person
	g_arrExtraButtons[actor].PressButtons(IN_FORWARD | IN_JUMP | IN_DUCK, CLIMB_HOLD);
	return CLIMB_BUSY;
}

