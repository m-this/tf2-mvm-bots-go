stock bool Go_sappableCandidate(int client, int i, TFTeam enemyTeam, bool giantsOnly, TFClassType class, float speedCheck)
{
	if (i == client)
	{
		return false;
	}
	if (!IsClientInGame(i))
	{
		return false;
	}
	if (!IsPlayerAlive(i))
	{
		return false;
	}
	if (TF2_GetClientTeam(i) != enemyTeam)
	{
		return false;
	}
	if (IsSentryBusterRobot(i))
	{
		return false;
	}
	if (giantsOnly && !TF2_IsMiniBoss(i))
	{
		return false;
	}
	if ((class > TFClass_Unknown) && (TF2_GetPlayerClass(i) != class))
	{
		return false;
	}
	if ((speedCheck > 0.0) && (GetEntPropFloat(i, Prop_Send, "m_flMaxspeed") < speedCheck))
	{
		return false;
	}
	return true;
}

