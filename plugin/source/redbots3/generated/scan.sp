/* Generated by internal/spbody from the Go it is named after. Do not edit. */

enum ScanObjectKind
{
	Go_ObjectSappable = 0,
	Go_ObjectTeleporter = 1,
	Go_ObjectCurrency = 2
};

enum ScanKind
{
	Go_KindEnemy = 0,
	Go_KindSappable = 1,
	Go_KindSappableHealing = 2,
	Go_KindAnyEnemy = 3
};

#define SCAN_NO_DISTANCE (999999.0)

// NearestSappableObject is util.sp:1325, GetNearestSappableObject: the closest
// enemy building a spy could sap.
stock int GetNearestSappableObject(int client, float maxDistance = 1000.0)
{
	float origin[3];
	GetClientAbsOrigin(client, origin);
	int myTeam = GetClientTeam(client);
	return Go_nearestObject(origin, myTeam, maxDistance, "obj_*", Go_ObjectSappable);
}

// NearestEnemyTeleporter is util.sp:1363, GetNearestEnemyTeleporter.
stock int GetNearestEnemyTeleporter(int client, float maxDistance = 999999.0)
{
	float origin[3];
	GetClientAbsOrigin(client, origin);
	int myTeam = GetClientTeam(client);
	return Go_nearestObject(origin, myTeam, maxDistance, "obj_teleporter", Go_ObjectTeleporter);
}

// NearestCurrencyPack is util.sp:1358, GetNearestCurrencyPack: the closest
// money the bot could pick up. Money has no team, so none is asked for.
stock int GetNearestCurrencyPack(int client, float maxDistance = 999999.0)
{
	float origin[3];
	GetClientAbsOrigin(client, origin);
	return Go_nearestObject(origin, 0, maxDistance, "item_currency*", Go_ObjectCurrency);
}

// nearestObject is the one entity loop: the closest entity of the classname,
// within maxDistance, that the kind's questions accept.
stock int Go_nearestObject(float origin[3], int myTeam, float maxDistance, const char[] classname, ScanObjectKind kind)
{
	float bestDistance = 999999.0;
	int bestEnt = -1;
	int ent = -1;
	for (;;)
	{
		ent = FindEntityByClassname(ent, classname);
		if (ent == -1)
		{
			break;
		}
		if (!Go_objectWanted(kind, ent, myTeam))
		{
			continue;
		}
		float distance = GetVectorDistance(origin, GetAbsOrigin(ent));
		if ((distance <= bestDistance) && (distance <= maxDistance))
		{
			bestDistance = distance;
			bestEnt = ent;
		}
	}
	return bestEnt;
}

// objectWanted is what each entity scan asks, in the order it asked it.
stock bool Go_objectWanted(ScanObjectKind kind, int ent, int myTeam)
{
	switch (kind)
	{
		case Go_ObjectSappable:
		{
			return (TF2_GetObjectType(ent) != TFObject_Sapper) && Go_buildingSappable(ent, myTeam);
		}
		case Go_ObjectTeleporter:
		{
			return Go_buildingSappable(ent, myTeam);
		}
	}
	// This pack has already been distributed to the team, or has not reached
	// the ground yet.
	return (GetEntProp(ent, Prop_Send, "m_bDistributed") != 1) && ((GetEntityFlags(ent) & FL_ONGROUND) != 0);
}

// buildingSappable is an enemy building standing on its own with no sapper on
// it yet.
stock bool Go_buildingSappable(int ent, int myTeam)
{
	if (BaseEntity_GetTeamNumber(ent) == myTeam)
	{
		return false;
	}
	if (TF2_IsPlacing(ent))
	{
		return false;
	}
	if (TF2_IsCarried(ent))
	{
		return false;
	}
	return !TF2_HasSapper(ent);
}

// PlayerSappable is util.sp:1437, IsPlayerSappable.
stock bool IsPlayerSappable(int client)
{
	if (TF2_IsPlayerInCondition(client, TFCond_Sapped))
	{
		return false;
	}
	if (TF2_IsInvulnerable(client))
	{
		return false;
	}
	return !TF2_IsPlayerInCondition(client, TFCond_Bonked);
}

// PlayerHealingSomething is util.sp:1690, IsPlayerHealingSomething.
stock bool IsPlayerHealingSomething(int client)
{
	int weapon = BaseCombatCharacter_GetActiveWeapon(client);
	if (weapon == -1)
	{
		return false;
	}
	return (TF2Util_GetWeaponID(weapon) == TF_WEAPON_MEDIGUN) && (GetEntPropEnt(weapon, Prop_Send, "m_hHealingTarget") != -1);
}

// sappableWanted is the three switches the spy's callers vary: giants only, one
// class, and a floor on speed.
stock bool Go_sappableWanted(int i, bool giantsOnly, TFClassType class, float speedCheck)
{
	if (giantsOnly && !TF2_IsMiniBoss(i))
	{
		return false;
	}
	if ((class > TFClass_Unknown) && (TF2_GetPlayerClass(i) != class))
	{
		return false;
	}
	return (speedCheck <= 0.0) || (GetEntPropFloat(i, Prop_Send, "m_flMaxspeed") >= speedCheck);
}

// NearestSappablePlayer is util.sp:1451, GetNearestSappablePlayer.
stock int GetNearestSappablePlayer(int client, float maxDistance, bool giantsOnly = false, TFClassType class = TFClass_Unknown, float speedCheck = 0.0)
{
	float origin[3];
	GetClientAbsOrigin(client, origin);
	return Go_nearestClient(client, origin, maxDistance, Go_KindSappable, false, giantsOnly, false, false, class, speedCheck);
}

// FarthestSappablePlayer is util.sp:1501, GetFarthestSappablePlayer. Same loop,
// starting at zero and keeping the largest.
stock int GetFarthestSappablePlayer(int client, float maxDistance, bool giantsOnly = false, TFClassType class = TFClass_Unknown, float speedCheck = 0.0)
{
	float origin[3];
	GetClientAbsOrigin(client, origin);
	return Go_nearestClient(client, origin, maxDistance, Go_KindSappable, true, giantsOnly, false, false, class, speedCheck);
}

// NearestSappablePlayerHealingSomeone is util.sp:1638. The same loop again with
// the medigun question in front of the sappable one, in that order, because the
// order is what the engine call trace records.
stock int GetNearestSappablePlayerHealingSomeone(int client, float maxDistance, bool giantsOnly = false, TFClassType class = TFClass_Unknown, float speedCheck = 0.0)
{
	float origin[3];
	GetClientAbsOrigin(client, origin);
	return Go_nearestClient(client, origin, maxDistance, Go_KindSappableHealing, false, giantsOnly, false, false, class, speedCheck);
}

// NearestEnemyCount is util.sp:1398, GetNearestEnemyCount: how many enemies are
// within max_distance of the client, not counting the client.
stock int GetNearestEnemyCount(int client, float maxDistance, bool ignoreUber = false)
{
	float origin[3];
	GetClientAbsOrigin(client, origin);
	int myTeam = GetClientTeam(client);
	int count = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (i == client)
		{
			continue;
		}
		if (!IsClientInGame(i))
		{
			continue;
		}
		if (!IsPlayerAlive(i))
		{
			continue;
		}
		if (GetClientTeam(i) == myTeam)
		{
			continue;
		}
		// Usually not a threat
		if (IsSentryBusterRobot(i))
		{
			continue;
		}
		if (ignoreUber && TF2_IsInvulnerable(i))
		{
			continue;
		}
		if (TF2_IsStealthed(i) && !IsCloakedPlayerExposed(i))
		{
			continue;
		}
		if (GetVectorDistance(WorldSpaceCenter(i), origin) <= maxDistance)
		{
			count++;
		}
	}
	return count;
}

// EnemyNearestToMe is util.sp:1183, FindEnemyNearestToMe: the closest enemy
// within max_distance, or -1. The four filters after the team check are the
// ones its callers switch on.
stock int FindEnemyNearestToMe(int client, float maxDistance, bool giantsOnly = false, bool ignoreUber = false, bool stunnedOnly = false, TFClassType class = TFClass_Unknown)
{
	float origin[3];
	origin = WorldSpaceCenter(client);
	return Go_nearestClient(client, origin, maxDistance, Go_KindEnemy, false, giantsOnly, ignoreUber, stunnedOnly, class, 0.0);
}

// EnemyPlayerNearestToPosition is util.sp:1550,
// GetEnemyPlayerNearestToPosition: the shortest of the loops, measuring from a
// position the caller supplies rather than from where the client stands.
stock int GetEnemyPlayerNearestToPosition(int client, float position[3], float maxDistance)
{
	return Go_nearestClient(client, position, maxDistance, Go_KindAnyEnemy, false, false, false, false, TFClass_Unknown, 0.0);
}

// nearestClient is the one client loop: the enemy nearest to origin within
// maxDistance, or the farthest, that the kind's questions accept.
//
// The five questions every variant asked come first, then the kind's own, then
// the distance. A candidate the kind refuses is never measured, which is the
// order the shipped loops had and the order the pinned traces hold.
stock int Go_nearestClient(int client, float origin[3], float maxDistance, ScanKind kind, bool farthest, bool giantsOnly, bool ignoreUber, bool stunnedOnly, TFClassType class, float speedCheck)
{
	TFTeam enemyTeam = GetPlayerEnemyTeam(client);
	float bestDistance = (farthest ? 0.0 : SCAN_NO_DISTANCE);
	int bestEntity = -1;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (!Go_enemyCandidate(client, i, enemyTeam))
		{
			continue;
		}
		if (!Go_wantedBy(kind, i, giantsOnly, ignoreUber, stunnedOnly, class, speedCheck))
		{
			continue;
		}
		float distance = GetVectorDistance(WorldSpaceCenter(i), origin);
		if (distance > maxDistance)
		{
			continue;
		}
		if (farthest && (distance < bestDistance))
		{
			continue;
		}
		if (!farthest && (distance > bestDistance))
		{
			continue;
		}
		bestDistance = distance;
		bestEntity = i;
	}
	return bestEntity;
}

// enemyCandidate is the five questions every client scan asks first, in the
// order it asks them: another slot, in the game, alive, on the other team, and
// not a sentry buster.
stock bool Go_enemyCandidate(int client, int i, TFTeam enemyTeam)
{
	if (i == client)
	{
		return false;
	}
	if (!IsClientInGame(i))
	{
		return false;
	}
	if (!IsPlayerAlive(i))
	{
		return false;
	}
	if (TF2_GetClientTeam(i) != enemyTeam)
	{
		return false;
	}
	return !IsSentryBusterRobot(i);
}

// wantedBy is what a kind asks after the five, in its own order.
stock bool Go_wantedBy(ScanKind kind, int i, bool giantsOnly, bool ignoreUber, bool stunnedOnly, TFClassType class, float speedCheck)
{
	switch (kind)
	{
		case Go_KindEnemy:
		{
			return Go_enemyWanted(i, giantsOnly, ignoreUber, stunnedOnly, class);
		}
		case Go_KindSappable:
		{
			return Go_sappableWanted(i, giantsOnly, class, speedCheck) && IsPlayerSappable(i);
		}
		case Go_KindSappableHealing:
		{
			return Go_sappableWanted(i, giantsOnly, class, speedCheck) && IsPlayerHealingSomething(i) && IsPlayerSappable(i);
		}
	}
	return true;
}

// enemyWanted is FindEnemyNearestToMe's four switches and the cloak question.
stock bool Go_enemyWanted(int i, bool giantsOnly, bool ignoreUber, bool stunnedOnly, TFClassType class)
{
	if (giantsOnly && !TF2_IsMiniBoss(i))
	{
		return false;
	}
	if (ignoreUber && TF2_IsInvulnerable(i))
	{
		return false;
	}
	if (stunnedOnly && !TF2_IsPlayerInCondition(i, TFCond_Dazed))
	{
		return false;
	}
	if ((class > TFClass_Unknown) && (TF2_GetPlayerClass(i) != class))
	{
		return false;
	}
	return !TF2_IsStealthed(i) || IsCloakedPlayerExposed(i);
}

// BestTargetForSpy is util.sp:1235, GetBestTargetForSpy: the four passes a spy
// makes over the enemy team, and then the healer behind whoever it found.
stock int GetBestTargetForSpy(int client, float maxDistance)
{
	// Find the nearest enemy engineer
	int target = FindEnemyNearestToMe(client, maxDistance, false, true, false, TFClass_Engineer);
	// Find the nearest stunned enemy
	if (target == -1)
	{
		target = FindEnemyNearestToMe(client, maxDistance, false, true, true, TFClass_Unknown);
	}
	// Find the nearest enemy giant
	if (target == -1)
	{
		target = FindEnemyNearestToMe(client, maxDistance, true, true, false, TFClass_Unknown);
	}
	// Find the nearest enemy
	if (target == -1)
	{
		target = FindEnemyNearestToMe(client, maxDistance, false, true, false, TFClass_Unknown);
	}
	// Target their healer first, if they have one
	if (target != -1)
	{
		int myTeam = GetClientTeam(client);
		for (int i = 0; i < TF2_GetNumHealers(target); i++)
		{
			int healer = TF2Util_GetPlayerHealer(target, i);
			if ((healer != -1) && BaseEntity_IsPlayer(healer) && (GetClientTeam(healer) != myTeam))
			{
				target = healer;
				break;
			}
		}
	}
	return target;
}

// PlayerEnemyTeam is util.sp:1044, GetPlayerEnemyTeam. Every one of the scans
// above opened by calling it, so it was an extern until they were all across;
// now it is here and the extern is gone, because a function owned in both
// places is the duplication this repository exists to remove.
stock TFTeam GetPlayerEnemyTeam(int client)
{
	return TF2_GetEnemyTeam(TF2_GetClientTeam(client));
}

// WorldSpaceCenter is util.sp:348. The middle of the entity, which is what the
// plugin measures ranges from rather than the feet.
stock float[] WorldSpaceCenter(int entity)
{
	float centre[3];
	BaseEntity_WorldSpaceCenter(entity, centre);
	return centre;
}

// AbsOrigin is util.sp:542. Where the entity is.
stock float[] GetAbsOrigin(int entity)
{
	float origin[3];
	BaseEntity_GetAbsOrigin(entity, origin);
	return origin;
}

