# Every version the test-bed pins. Bump here and nothing else.
#
# These match the ones tf2-archipelago builds this mod with, which is where the
# test-bed's build script came from. A test server that compiles against a
# different SourceMod than the servers people actually run is a test server
# that answers a question nobody asked.

# spcomp 1.12.0-git7246 segfaults on this mod (upstream issue #5), with no
# diagnostic and exit 139. This is the drop the mod's own CI uses.
SOURCEMOD_BRANCH=1.12
SOURCEMOD_VERSION=1.12.0-git7164

# The mod's dependencies. Two compiled extensions, taken prebuilt because
# nothing we change is inside them, and three gamedata plugins compiled here.
CBASENPC_VERSION=1.15.4.126
ACTIONS_VERSION=v3.9.2
RIPEXT_VERSION=1.3.2
TF2ATTRIBUTES_VERSION=v1.7.5
TFECONDATA_VERSION=0.19.1.5
TF2UTILS_VERSION=master
STOCKSOUP_REF=master
SM_STOCK_OFFICERSPY_REF=main
