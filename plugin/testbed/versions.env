# Every version the test-bed pins. Bump here and nothing else.
#
# SOURCEMOD_BRANCH, SOURCEMOD_VERSION and SOURCEMOD_SHA256 are not only this
# bed's business. They are the compiler the mod is built with everywhere:
# tf2-archipelago's deploy/bots/build.sh reads these keys out of this file,
# from the Go module cache, rather than keeping a copy of them. It used to keep
# a copy, called DEFENDERBOTS_SOURCEMOD_VERSION, and the copy and this file sat
# ninety builds apart with nothing saying so.
#
# So they are a contract: one KEY=value per line, these names. Renaming a key or
# writing it some other way breaks that build rather than this one.
#
# The rest match what tf2-archipelago builds this mod with, which is where the
# test-bed's build script came from. A test server that compiles against a
# different SourceMod than the servers people actually run is a test server
# that answers a question nobody asked.

# The compiler, and only the compiler. The SourceMod the bed's server *runs* is a
# different version and is the floor below.
#
# 1.13 makes Address an int64 (typedef Address = int64, and the plugin carries
# __Int64_Address__ so natives read it as one). A methodmap is still one 32-bit
# cell and cannot derive from int64, so the mod's pointer methodmaps stay cells
# and every crossing between the two is explicit: widening zero-extends,
# narrowing refuses a value that does not fit 32 bits. The includes of the
# extensions that pass pointers as cells say so (patches/).
#
# AlliedModders purges old drops, so this pin will 404 one day. Move it to the
# newest drop of the branch when it does.
#
# SOURCEMOD_SHA256 is the tarball's, checked after download, here and by
# tf2-archipelago's deploy/bots/build.sh. A drop rebuilt under the same name is
# a different compiler, and that is worth a failed build.
SOURCEMOD_BRANCH=1.13
SOURCEMOD_VERSION=1.13.0-git7481
SOURCEMOD_SHA256=50d37e3e5e2875b87d4ad562436e08c2e985b8ead6358b07e11c8e973a3eeb96

# The oldest SourceMod the bed's server may be running, and the TF2 build that
# floor comes from.
#
# Nothing here installs the server's SourceMod. cm2network/tf2:sourcemod puts it
# in the game volume on the container's first start, at whatever the branch's
# latest was that day, and the volume then keeps it for months. So the runner
# asks the server instead: cmd/testbed reads `sm version` over rcon and refuses
# a run on anything older than this.
#
# It is here because of what the mismatch looks like. TF2 build 11076587
# (2026-10-02) moved the KeyValues memory layout. SourceMod up to and including
# 1.12.0-git7253 builds KeyValues in the old layout and reads the new one
# (alliedmodders/sourcemod#2587, fixed by #2588, which is git7255). The bots buy
# their upgrades with a FakeClientCommandKeyValues MVM_Upgrade, and on the old
# drop every one of those is refused without a word: 35 attempted, 35 refused,
# against 44 bought on git7255. A run measured on that server reports the bots
# not buying upgrades, which reads as a defect in this repository and is not
# one. That is an evening of A/B, and it nearly happened.
#
# Raise it when a TF2 update moves the layout again. TESTBED_SOURCEMOD_MIN
# overrides it for one run, and empty means no floor.
#
# It is the compiler's drop now, because a plugin built with 1.13's int64
# Address only runs on a 1.13 server.
SOURCEMOD_RUNTIME_MIN=1.13.0-git7481
SOURCEMOD_TF2_SERVER_VERSION=11087207

# The mod's dependencies. Two compiled extensions, taken prebuilt because
# nothing we change is inside them, and three gamedata plugins compiled here.
# Refs are tags or full commits, never a branch.
CBASENPC_VERSION=1.15.4.126

# The release binary, and the commit whose includes and gamedata match it. The
# v4.0.1 tag points at 9f7d80f, which predates the API the release zip ships
# (OnActionTransition, no identity natives); master at this commit carries the
# zip's includes and gamedata byte for byte, CRLF aside.
ACTIONS_VERSION=v4.0.1
ACTIONS_SHA256=1a81e39f6bd4c67204144e1e726da772e8449f93f9f974775702aa9ce1b16c27
ACTIONS_COMMIT=eb170184c0db6f5e1e7c3a1548e55202ab28dd7c

RIPEXT_VERSION=1.3.2

# FlaminSarge/tf2attributes#71, the int64 Address port, still open upstream.
# v1.7.5 does not compile on 1.13, and its natives read an Address as a cell,
# which an int64 caller passes by reference. Back to upstream when #71 merges.
TF2ATTRIBUTES_REPO=Mikusch/tf2attributes
TF2ATTRIBUTES_VERSION=64cf3474b7c4fb9232309c02cd87ebe676e2fbc0

# The x64 line is the int64 Address one, 32-bit included; 0.19.1.8 is the
# 1.12 backport and does not compile on 1.13.
TFECONDATA_VERSION=0.19.1-x64.8
TF2UTILS_VERSION=1.5.0
STOCKSOUP_REF=498e2bc64ea1f275bcb5aeeefc03573bfaf95378
