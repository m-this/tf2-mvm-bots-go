	{Name: "watch_idle_bots", ConVar: "sm_redbots_feature_watch_idle_bots", Default: false, About: "The stuck watchdog also rescues a bot that has no behaviour at all, not only one that cannot reach its goal."},
	{Name: "watch_lurking_snipers", ConVar: "sm_redbots_feature_watch_lurking_snipers", Default: true, About: "The stuck watchdog also rescues a sniper parked nowhere near a spot, which is the one it used to miss."},
	{Name: "ammo_failover", ConVar: "sm_redbots_feature_ammo_failover", Default: false, About: "A bot whose path to the ammo it picked keeps failing takes the next pack, then gives up, rather than walking at a wall."},
