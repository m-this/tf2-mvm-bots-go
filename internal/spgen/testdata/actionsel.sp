	ActionSel_RoundBonus = 9,
	ActionSel_RoundBetweenRounds = 10
};

enum struct ActionSel_Flags
{
	bool MoneyToCollect;
	bool InUpgradeZone;
	bool ShoppedThisBreak;
	bool MovingToFront;
	bool UpgradesEnabled;
	bool HasUpgraded;
	bool UpgradeMidRound;
	bool HasSniperRifle;
	bool SniperStalled;
	bool AttackTargetFound;
	bool TankTargetFound;
	bool GiantToMark;
	bool NearbyMoney;
	bool StickyTrapPossible;
}

stock ActionSel_Action ActionSel_SelectFilled(ActionSel_RoundState state, ActionSel_Class class_, ActionSel_Flags f)
{
	ActionSel_Action a = ActionSel_Select(state, class_, f);
	if (a == ActionSel_ActionStrandedAsShipped)
	{
		return ActionSel_ActionGuardPoint;
	}
	return a;
}

stock bool ActionSel_Reachable(ActionSel_Class class_, ActionSel_Flags f)
{
	if (class_ == ActionSel_ClassSniper)
	{
		return true;
	}
	return (!f.HasSniperRifle && !f.SniperStalled);
}

stock bool ActionSel_Suspends(ActionSel_Action a)
{
	return ((a != ActionSel_ActionNone) && (a < ActionSel_ActionKeepWalkingToFront));
}

stock ActionSel_Action ActionSel_Select(ActionSel_RoundState state, ActionSel_Class class_, ActionSel_Flags f)
{
	switch (state)
	{
		case ActionSel_RoundBetweenRounds:
		{
			return ActionSel_SelectBetweenRounds(class_, f);
		}
		case ActionSel_RoundRunning:
		{
			return ActionSel_SelectRoundRunning(class_, f);
		}
	}
	return ActionSel_ActionWaitOutsideRound;
}

stock ActionSel_Action ActionSel_SelectBetweenRounds(ActionSel_Class class_, ActionSel_Flags f)
{
	if (f.MoneyToCollect)
	{
		return ActionSel_ActionCollectMoneyIsPossible;
	}
	if ((!f.InUpgradeZone && !f.ShoppedThisBreak) && !f.MovingToFront)
	{
		if (f.UpgradesEnabled)
		{
			return ActionSel_ActionGotoUpgradeBetweenRounds;
		}
		return ActionSel_ActionMoveToFrontSkipUpgrading;
	}
	if ((ActionSel_ShouldTakeUpPosition(class_, f) || f.SniperStalled) && !f.MovingToFront)
	{
		return ActionSel_ActionMoveToFrontShoppingDone;
	}
	if (f.MovingToFront)
	{
		return ActionSel_ActionKeepWalkingToFront;
	}
	return ActionSel_ActionKeepOwnBreakBehaviour;
}

stock ActionSel_Action ActionSel_SelectRoundRunning(ActionSel_Class class_, ActionSel_Flags f)
{
	if ((f.UpgradesEnabled && (!f.HasUpgraded || f.UpgradeMidRound)) && !f.InUpgradeZone)
	{
		return ActionSel_ActionGotoUpgradeBuyNow;
	}
	switch (class_)
	{
		case ActionSel_ClassMedic:
		{
			return ActionSel_ActionKeepHealing;
		}
		case ActionSel_ClassScout:
		{
			if (f.MoneyToCollect)
			{
				return ActionSel_ActionCollectMoneyCollecting;
			}
			if (f.GiantToMark)
			{
				return ActionSel_ActionMarkGiant;
			}
			if (f.TankTargetFound)
			{
				return ActionSel_ActionAttackTankScout;
			}
			if (f.AttackTargetFound)
			{
				return ActionSel_ActionDefenderAttackScout;
			}
		}
		case ActionSel_ClassSniper:
		{
			if (f.HasSniperRifle && !f.SniperStalled)
			{
				return ActionSel_ActionKeepSnipingPosition;
			}
			return ActionSel_ActionDefenderAttackSniper;
		}
		case ActionSel_ClassEngineer:
		{
			return ActionSel_ActionEngineerIdle;
		}
		case ActionSel_ClassSpy:
		{
			return ActionSel_ActionSpyLurk;
		}
		case ActionSel_ClassHeavy:
		{
			if (f.AttackTargetFound)
			{
				return ActionSel_ActionDefenderAttackIsPossible;
			}
			if (f.TankTargetFound)
			{
				return ActionSel_ActionAttackTank;
			}
			if (f.NearbyMoney)
			{
				return ActionSel_ActionCollectNearMoney;
			}
		}
		case ActionSel_ClassDemoMan:
		{
			if (f.TankTargetFound)
			{
				return ActionSel_ActionAttackTank;
			}
			if (f.AttackTargetFound)
			{
				return ActionSel_ActionDefenderAttackIsPossible;
			}
			if (f.StickyTrapPossible)
			{
				return ActionSel_ActionStickyTrap;
			}
			if (f.NearbyMoney)
			{
				return ActionSel_ActionCollectNearMoney;
			}
		}
		case ActionSel_ClassSoldier, ActionSel_ClassPyro:
		{
			if (f.TankTargetFound)
			{
				return ActionSel_ActionAttackTank;
			}
			if (f.AttackTargetFound)
			{
				return ActionSel_ActionDefenderAttackIsPossible;
			}
			if (f.NearbyMoney)
			{
				return ActionSel_ActionCollectNearMoney;
			}
		}
	}
	if (ActionSel_CanGuardTheHatch(class_))
	{
		return ActionSel_ActionGuardPoint;
	}
	if (class_ == ActionSel_ClassUnknown)
	{
		return ActionSel_ActionKeepWaitingForClass;
	}
	return ActionSel_ActionStrandedAsShipped;
}

stock bool ActionSel_ShouldTakeUpPosition(ActionSel_Class class_, ActionSel_Flags f)
{
	switch (class_)
	{
		case ActionSel_ClassEngineer, ActionSel_ClassSpy:
		{
			return false;
		}
		case ActionSel_ClassSniper:
		{
			return !f.HasSniperRifle;
		}
	}
	return true;
}

stock bool ActionSel_CanGuardTheHatch(ActionSel_Class class_)
{
	switch (class_)
	{
		case ActionSel_ClassSoldier, ActionSel_ClassPyro, ActionSel_ClassDemoMan, ActionSel_ClassHeavy:
		{
			return true;
		}
	}
	return false;
}

/* The decision as data, so the edge can ask lazily
 *
 * Three of the predicates have side effects, so filling them all in
 * before deciding is not what the plugin does today. A node names one
 * predicate and the node to go to for each answer; the edge asks for a
 * predicate only when the walk reaches it, and never twice, because the
 * answer is what chose the next node.
 *
 * A node with ActionSel_NodePredicate of -1 answers: ActionSel_NodeWhenTrue
 * holds the outcome.
 */
