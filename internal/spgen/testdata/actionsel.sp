{
	ActionSel_ActionNone = 0,
	ActionSel_ActionCollectMoneyIsPossible = 1,
	ActionSel_ActionGotoUpgradeBetweenRounds = 2,
	ActionSel_ActionMoveToFrontSkipUpgrading = 3,
	ActionSel_ActionMoveToFrontShoppingDone = 4,
	ActionSel_ActionGotoUpgradeBuyNow = 5,
	ActionSel_ActionCollectMoneyCollecting = 6,
